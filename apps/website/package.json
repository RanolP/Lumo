{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build ../../crates/playground-wasm --target web --out-dir ../../apps/website/src/wasm --out-name lumo_playground_wasm",
    "typst:build": "node scripts/build-formalization.mjs",
    "dev": "pnpm typst:build && vite",
    "dev:with-wasm": "pnpm wasm:build && pnpm dev",
    "build": "pnpm typst:build && vite build && node -e \"fs.copyFileSync('dist/index.html', 'dist/404.html')\"",
    "build:with-wasm": "pnpm wasm:build && pnpm check:types && pnpm build",
    "preview": "vite preview",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.4",
    "monaco-editor": "^0.54.0",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-solid": "^2.11.10"
  }
}
