// Ported from legacy/packages/libcore/src#js/ops.lumo (D-45/D-48;
// tail `resume` restored, D-54). Decl-only today: `!` desugars structurally over
// the Bool tags (D-48), so nothing selects this impl yet.

impl Bool: Not {
  fn not(self): Self = match self {
    .true => resume(Bool.false),
    .false => resume(Bool.true),
  }
}
