use libcore.prelude.{String, Number, Bool};
use libstd.list.{List};

// A complete grammar: token declarations + node rules
data Grammar { .mk(List[String], List[Rule]) }

// A named rule: `Name = body`
data Rule { .mk(String, RuleBody) }

// Rule body: sequence, alternatives, or a Pratt expression table
data RuleBody {
  .sequence(List[Element]),
  .alternatives(List[Alternative]),
  .pratt(List[String], List[PrattAlt])
}

// One row in a pratt block: `Name: <pattern> with bp(L, R)`
data PrattAlt { .mk(String, List[Element], BindingPower) }

// bp(left, right) — None means no operand on that side (prefix / postfix)
data BindingPower { .mk(BpVal, BpVal) }
data BpVal { .none, .num(Number) }

// An alternative in `| A | B | C`
data Alternative { .mk(String) }

// An element in a rule sequence
data Element {
  .token(TokenRef),
  .node(NodeRef),
  .labeled(String, Element),
  .optional(Element),
  .repeated(Element),
  .group(List[Element])
}

// A token reference
data TokenRef {
  .keyword(String),
  .symbol(String),
  .named(String)
}

// A node reference
data NodeRef { .mk(String) }
