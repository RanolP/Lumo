use libcore.prelude.{String, Number, Bool};
use libstd.list.{List};

fn generate_ast(grammar: Grammar): String =
  match grammar { .mk(token_defs, attrs, rules) => {
    let s = "// Auto-generated by langue. Do not edit.\n";
    let s = s + "// Regenerate: scripts/gen_langue.sh\n\n";
    let s = s + "use super::SyntaxKind;\n";
    let s = s + "use super::{SyntaxNode, SyntaxElement, LosslessToken};\n\n";
    let s = s + "pub trait AstNode<'a>: Sized {\n";
    let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self>;\n";
    let s = s + "    fn syntax(&self) -> &'a SyntaxNode;\n";
    let s = s + "}\n\n";
    emit_ast_rules(s, token_defs, rules)
  }}

fn emit_ast_rules(s: String, token_defs: List[String], rules: List[Rule]): String =
  match rules {
    .nil => s,
    .cons(rule, rest) =>
      match rule { .mk(name, body) => {
        let s2 = match body {
          .sequence(elems) => emit_struct_node(s, name, elems, token_defs),
          .alternatives(alts) =>
            if is_token_only_alternatives(alts) { emit_token_wrapper_node(s, name) }
            else { emit_enum_node(s, name, alts) },
          .pratt(atom_names, alts) => emit_pratt_rule(s, name, atom_names, alts, token_defs)
        };
        emit_ast_rules(s2, token_defs, rest)
      }}
  }

fn emit_pratt_rule(s: String, rule_name: String, atom_names: List[String], alts: List[PrattAlt], token_defs: List[String]): String {
  let s2 = emit_pratt_alt_structs(s, alts, token_defs);
  let all_names = list_concat_string(atom_names, collect_pratt_alt_names(alts));
  emit_enum_from_names(s2, rule_name, all_names)
}

fn emit_pratt_alt_structs(s: String, alts: List[PrattAlt], token_defs: List[String]): String =
  emit_pratt_alt_structs_dedup(s, alts, token_defs, List.nil)

fn emit_pratt_alt_structs_dedup(s: String, alts: List[PrattAlt], token_defs: List[String], seen: List[String]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        if list_contains_string(seen, name) {
          emit_pratt_alt_structs_dedup(s, rest, token_defs, seen)
        } else {
          let s2 = emit_struct_node(s, name, elems, token_defs);
          emit_pratt_alt_structs_dedup(s2, rest, token_defs, List.cons(name, seen))
        }
      }
  }

fn collect_pratt_alt_names(alts: List[PrattAlt]): List[String] =
  collect_pratt_alt_names_dedup(alts, List.nil)

fn collect_pratt_alt_names_dedup(alts: List[PrattAlt], seen: List[String]): List[String] =
  match alts {
    .nil => List.nil,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        if list_contains_string(seen, name) {
          collect_pratt_alt_names_dedup(rest, seen)
        } else {
          List.cons(name, collect_pratt_alt_names_dedup(rest, List.cons(name, seen)))
        }
      }
  }

fn emit_enum_from_names(s: String, enum_name: String, names: List[String]): String {
  let s = s + "pub enum " + enum_name + "<'a> {\n";
  let s = emit_variants_from_names(s, names);
  let s = s + "}\n\n";
  let s = s + "impl<'a> AstNode<'a> for " + enum_name + "<'a> {\n";
  let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self> {\n";
  let s = s + "        None\n";
  let s = emit_cast_chain_from_names(s, names);
  let s = s + "    }\n";
  let s = s + "    fn syntax(&self) -> &'a SyntaxNode {\n";
  let s = s + "        match self {\n";
  let s = emit_syntax_arms_from_names(s, names);
  let s = s + "        }\n";
  let s = s + "    }\n";
  s + "}\n\n"
}

fn emit_variants_from_names(s: String, names: List[String]): String =
  match names {
    .nil => s,
    .cons(name, rest) =>
      emit_variants_from_names(s + "    " + name + "(" + name + "<'a>),\n", rest)
  }

fn emit_cast_chain_from_names(s: String, names: List[String]): String =
  match names {
    .nil => s,
    .cons(name, rest) => {
      let line = "            .or_else(|| " + name + "::cast(node).map(Self::" + name + "))\n";
      emit_cast_chain_from_names(s + line, rest)
    }
  }

fn emit_syntax_arms_from_names(s: String, names: List[String]): String =
  match names {
    .nil => s,
    .cons(name, rest) => {
      let line = "            Self::" + name + "(n) => n.syntax(),\n";
      emit_syntax_arms_from_names(s + line, rest)
    }
  }

fn emit_struct_node(s: String, name: String, elems: List[Element], token_defs: List[String]): String {
  let kind = to_screaming_snake(name);
  let s = s + "pub struct " + name + "<'a>(pub(crate) &'a SyntaxNode);\n\n";
  let s = s + "impl<'a> AstNode<'a> for " + name + "<'a> {\n";
  let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self> {\n";
  let s = s + "        (node.kind == SyntaxKind::" + kind + ").then(|| Self(node))\n";
  let s = s + "    }\n";
  let s = s + "    fn syntax(&self) -> &'a SyntaxNode { self.0 }\n";
  let s = s + "}\n\n";
  emit_accessors(s, name, elems, token_defs)
}

fn emit_accessors(s: String, struct_name: String, elems: List[Element], token_defs: List[String]): String {
  let has_labeled = has_labeled_elements(elems);
  if has_labeled {
    let s = s + "impl<'a> " + struct_name + "<'a> {\n";
    let s = emit_accessors_for_elements(s, elems, token_defs);
    let s = s + "}\n\n";
    s
  } else { s }
}

fn has_labeled_element(elem: Element): Bool =
  match elem {
    .labeled(_, _) => Bool.true,
    .group(elems) => has_labeled_elements(elems),
    .repeated(inner) => has_labeled_element(inner),
    .optional(inner) => has_labeled_element(inner),
    _ => Bool.false
  }

fn has_labeled_elements(elems: List[Element]): Bool =
  match elems {
    .nil => Bool.false,
    .cons(elem, rest) =>
      if has_labeled_element(elem) { Bool.true }
      else { has_labeled_elements(rest) }
  }

fn emit_accessors_for_element(s: String, elem: Element, token_defs: List[String]): String =
  match elem {
    .labeled(label, inner) => emit_single_accessor(s, label, inner, token_defs),
    .repeated(inner) => emit_accessors_for_element_repeated(s, inner, token_defs),
    .optional(inner) => emit_accessors_for_element(s, inner, token_defs),
    .group(inner_elems) => emit_accessors_for_elements(s, inner_elems, token_defs),
    _ => s
  }

fn emit_accessors_for_elements(s: String, elems: List[Element], token_defs: List[String]): String =
  match elems {
    .nil => s,
    .cons(elem, rest) => {
      let s2 = emit_accessors_for_element(s, elem, token_defs);
      emit_accessors_for_elements(s2, rest, token_defs)
    }
  }

fn emit_accessors_for_element_repeated(s: String, elem: Element, token_defs: List[String]): String =
  match elem {
    .labeled(label, inner) => emit_single_accessor_repeated(s, label, inner, token_defs),
    .group(elems) => emit_accessors_for_elements_repeated(s, elems, token_defs),
    .repeated(inner) => emit_accessors_for_element_repeated(s, inner, token_defs),
    .optional(inner) => emit_accessors_for_element_repeated(s, inner, token_defs),
    _ => s
  }

fn emit_accessors_for_elements_repeated(s: String, elems: List[Element], token_defs: List[String]): String =
  match elems {
    .nil => s,
    .cons(elem, rest) => {
      let s2 = emit_accessors_for_element_repeated(s, elem, token_defs);
      emit_accessors_for_elements_repeated(s2, rest, token_defs)
    }
  }

fn emit_single_accessor(s: String, label: String, elem: Element, token_defs: List[String]): String =
  match elem {
    .token(t) => emit_token_accessor(s, label, t, Bool.false),
    .node(n) =>
      match n { .mk(name) =>
        if list_contains_string(token_defs, name) { emit_token_accessor(s, label, TokenRef.named(name), Bool.false) }
        else { emit_node_accessor(s, label, name, Bool.false) }
      },
    .optional(inner) => emit_single_accessor(s, label, inner, token_defs),
    .repeated(inner) => emit_single_accessor_repeated(s, label, inner, token_defs),
    .labeled(_, inner) => emit_single_accessor(s, label, inner, token_defs),
    .group(elems) => emit_accessors_for_elements(s, elems, token_defs)
  }

fn emit_single_accessor_repeated(s: String, label: String, elem: Element, token_defs: List[String]): String =
  match elem {
    .token(t) => emit_token_accessor(s, label, t, Bool.true),
    .node(n) =>
      match n { .mk(name) =>
        if list_contains_string(token_defs, name) { emit_token_accessor(s, label, TokenRef.named(name), Bool.true) }
        else { emit_node_accessor(s, label, name, Bool.true) }
      },
    .optional(inner) => emit_single_accessor_repeated(s, label, inner, token_defs),
    .repeated(inner) => emit_single_accessor_repeated(s, label, inner, token_defs),
    .labeled(_, inner) => emit_single_accessor_repeated(s, label, inner, token_defs),
    .group(elems) => emit_accessors_for_elements_repeated(s, elems, token_defs)
  }

fn token_kind_from_ref(t: TokenRef): String =
  match t {
    .named(name) => to_screaming_snake(name),
    .keyword(kw) => keyword_variant(kw),
    .symbol(sym) => symbol_variant(sym)
  }

fn emit_token_accessor(s: String, label: String, t: TokenRef, repeated: Bool): String {
  let kind = token_kind_from_ref(t);
  if repeated {
    let s = s + "    pub fn " + label + "(&self) -> impl Iterator<Item = &'a LosslessToken> + 'a {\n";
    let s = s + "        self.0.children.iter().filter_map(|c| match c {\n";
    let s = s + "            SyntaxElement::Token(t) if t.kind == SyntaxKind::" + kind + " => Some(t),\n";
    let s = s + "            _ => None,\n";
    let s = s + "        })\n";
    s + "    }\n"
  } else {
    let s = s + "    pub fn " + label + "(&self) -> Option<&'a LosslessToken> {\n";
    let s = s + "        self.0.children.iter().find_map(|c| match c {\n";
    let s = s + "            SyntaxElement::Token(t) if t.kind == SyntaxKind::" + kind + " => Some(t),\n";
    let s = s + "            _ => None,\n";
    let s = s + "        })\n";
    s + "    }\n"
  }
}

fn emit_node_accessor(s: String, label: String, node_name: String, repeated: Bool): String =
  if repeated {
    let s = s + "    pub fn " + label + "(&self) -> impl Iterator<Item = " + node_name + "<'a>> + 'a {\n";
    let s = s + "        self.0.children.iter().filter_map(|c| match c {\n";
    let s = s + "            SyntaxElement::Node(n) => " + node_name + "::cast(n),\n";
    let s = s + "            _ => None,\n";
    let s = s + "        })\n";
    s + "    }\n"
  } else {
    let s = s + "    pub fn " + label + "(&self) -> Option<" + node_name + "<'a>> {\n";
    let s = s + "        self.0.children.iter().find_map(|c| match c {\n";
    let s = s + "            SyntaxElement::Node(n) => " + node_name + "::cast(n),\n";
    let s = s + "            _ => None,\n";
    let s = s + "        })\n";
    s + "    }\n"
  }

fn emit_enum_node(s: String, name: String, alts: List[Alternative]): String {
  let s = s + "pub enum " + name + "<'a> {\n";
  let s = emit_enum_variants(s, alts);
  let s = s + "}\n\n";
  let s = s + "impl<'a> AstNode<'a> for " + name + "<'a> {\n";
  let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self> {\n";
  let s = s + "        None\n";
  let s = emit_enum_cast_chain(s, alts);
  let s = s + "    }\n";
  let s = s + "    fn syntax(&self) -> &'a SyntaxNode {\n";
  let s = s + "        match self {\n";
  let s = emit_enum_syntax_arms(s, alts);
  let s = s + "        }\n";
  let s = s + "    }\n";
  let s = s + "}\n\n";
  s
}

fn emit_enum_variants(s: String, alts: List[Alternative]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name) =>
        emit_enum_variants(s + "    " + name + "(" + name + "<'a>),\n", rest)
      }
  }

fn emit_enum_cast_chain(s: String, alts: List[Alternative]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name) => {
        let line = "            .or_else(|| " + name + "::cast(node).map(Self::" + name + "))\n";
        emit_enum_cast_chain(s + line, rest)
      }}
  }

fn emit_enum_syntax_arms(s: String, alts: List[Alternative]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name) => {
        let line = "            Self::" + name + "(n) => n.syntax(),\n";
        emit_enum_syntax_arms(s + line, rest)
      }}
  }

fn emit_token_wrapper_node(s: String, name: String): String {
  let kind = to_screaming_snake(name);
  let s = s + "pub struct " + name + "<'a>(pub(crate) &'a SyntaxNode);\n\n";
  let s = s + "impl<'a> AstNode<'a> for " + name + "<'a> {\n";
  let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self> {\n";
  let s = s + "        (node.kind == SyntaxKind::" + kind + ").then(|| Self(node))\n";
  let s = s + "    }\n";
  let s = s + "    fn syntax(&self) -> &'a SyntaxNode { self.0 }\n";
  let s = s + "}\n\n";
  s
}
