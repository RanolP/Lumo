use libcore.prelude.{String, Number, Bool};
use libcore.string.{StrOps};
use libcore.cmp.{PartialEq, PartialOrd};
use libcore.ops.{Add, Sub};
use libstd.list.{List};

// ---------------------------------------------------------------------------
// Naming helpers
// ---------------------------------------------------------------------------

// PascalCase to SCREAMING_SNAKE_CASE
fn to_screaming_snake(name: String): String =
  to_screaming_snake_loop(name, 0, "")

fn to_screaming_snake_loop(name: String, i: Number, acc: String): String =
  if i >= name.len() { acc } else {
    let c = name.char_at(i);
    let code = c.char_code_at(0);
    let is_upper = if code >= 65 { code <= 90 } else { Bool.false };
    if is_upper {
      if 0 < i {
        // Check if previous char was lowercase or digit
        let prev_code = name.char_at(i - 1).char_code_at(0);
        let prev_lower = if prev_code >= 97 { prev_code <= 122 } else { Bool.false };
        let prev_digit = if prev_code >= 48 { prev_code <= 57 } else { Bool.false };
        if prev_lower { to_screaming_snake_loop(name, i + 1, acc + "_" + to_upper_char(c)) }
        else if prev_digit { to_screaming_snake_loop(name, i + 1, acc + "_" + to_upper_char(c)) }
        else { to_screaming_snake_loop(name, i + 1, acc + to_upper_char(c)) }
      } else { to_screaming_snake_loop(name, i + 1, acc + to_upper_char(c)) }
    } else { to_screaming_snake_loop(name, i + 1, acc + to_upper_char(c)) }
  }

fn to_upper_char(c: String): String {
  let code = c.char_code_at(0);
  if code >= 97 {
    if code <= 122 { StrOps.from_char_code(code - 32) } else { c }
  } else { c }
}

fn keyword_variant(kw: String): String =
  to_upper_string(kw) + "_KW"

fn to_upper_string(s: String): String =
  to_upper_string_loop(s, 0, "")

fn to_upper_string_loop(s: String, i: Number, acc: String): String =
  if i >= s.len() { acc }
  else { to_upper_string_loop(s, i + 1, acc + to_upper_char(s.char_at(i))) }

fn symbol_variant(sym: String): String =
  if sym == "#" { "HASH" }
  else if sym == "(" { "L_PAREN" }
  else if sym == ")" { "R_PAREN" }
  else if sym == "[" { "L_BRACKET" }
  else if sym == "]" { "R_BRACKET" }
  else if sym == "{" { "L_BRACE" }
  else if sym == "}" { "R_BRACE" }
  else if sym == ";" { "SEMICOLON" }
  else if sym == ":" { "COLON" }
  else if sym == "," { "COMMA" }
  else if sym == "=" { "EQUALS" }
  else if sym == ":=" { "COLON_EQ" }
  else if sym == "=>" { "FAT_ARROW" }
  else if sym == "->" { "ARROW" }
  else if sym == "." { "DOT" }
  else if sym == "+" { "PLUS" }
  else if sym == "-" { "MINUS" }
  else if sym == "*" { "STAR" }
  else if sym == "/" { "SLASH" }
  else if sym == "%" { "PERCENT" }
  else if sym == "!" { "BANG" }
  else if sym == "<" { "LT" }
  else if sym == ">" { "GT" }
  else if sym == "<=" { "LT_EQ" }
  else if sym == ">=" { "GT_EQ" }
  else if sym == "==" { "EQ_EQ" }
  else if sym == "!=" { "BANG_EQ" }
  else if sym == "&&" { "AMP_AMP" }
  else if sym == "||" { "PIPE_PIPE" }
  else if sym == "_" { "UNDERSCORE" }
  else { "SYM_" + sym }

// ---------------------------------------------------------------------------
// Token collection: gather all keywords and symbols from rules
// ---------------------------------------------------------------------------

// Collect unique, sorted keywords and symbols from all rules
fn collect_tokens(grammar: Grammar): CollectedTokens =
  match grammar { .mk(token_defs, attrs, rules) => {
    let pair = collect_tokens_from_rules(rules, List.nil, List.nil);
    match pair { .mk(kws, syms) =>
      CollectedTokens.mk(sort_strings(dedupe_strings(kws)), sort_strings(dedupe_strings(syms)))
    }
  }}

data CollectedTokens { .mk(List[String], List[String]) }

data StringPair { .mk(List[String], List[String]) }

fn collect_tokens_from_rules(rules: List[Rule], kws: List[String], syms: List[String]): StringPair =
  match rules {
    .nil => StringPair.mk(kws, syms),
    .cons(rule, rest) =>
      match rule { .mk(name, body) => {
        let pair = collect_tokens_from_body(body, kws, syms);
        match pair { .mk(kws2, syms2) =>
          collect_tokens_from_rules(rest, kws2, syms2)
        }
      }}
  }

fn collect_tokens_from_body(body: RuleBody, kws: List[String], syms: List[String]): StringPair =
  match body {
    .sequence(elems) => collect_tokens_from_elements(elems, kws, syms),
    .alternatives(alts) => collect_tokens_from_alts(alts, kws, syms),
    .pratt(atom_names, alts) => collect_tokens_from_pratt_alts(alts, kws, syms)
  }

fn collect_tokens_from_pratt_alts(alts: List[PrattAlt], kws: List[String], syms: List[String]): StringPair =
  match alts {
    .nil => StringPair.mk(kws, syms),
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) => {
        let pair = collect_tokens_from_elements(elems, kws, syms);
        match pair { .mk(kws2, syms2) =>
          collect_tokens_from_pratt_alts(rest, kws2, syms2)
        }
      }}
  }

fn collect_tokens_from_alts(alts: List[Alternative], kws: List[String], syms: List[String]): StringPair =
  match alts {
    .nil => StringPair.mk(kws, syms),
    .cons(alt, rest) =>
      match alt { .mk(name) => {
        // If name starts with uppercase (A-Z, 65-90), it's a rule reference — skip.
        // Otherwise it's a quoted token literal — classify as keyword or symbol.
        let code = name.char_code_at(0);
        if code >= 65 {
          if code <= 90 { collect_tokens_from_alts(rest, kws, syms) }
          else { collect_alt_token(name, rest, kws, syms) }
        } else { collect_alt_token(name, rest, kws, syms) }
      }}
  }

fn collect_alt_token(name: String, rest: List[Alternative], kws: List[String], syms: List[String]): StringPair =
  if has_alpha(name, 0) { collect_tokens_from_alts(rest, List.cons(name, kws), syms) }
  else { collect_tokens_from_alts(rest, kws, List.cons(name, syms)) }

fn collect_tokens_from_elements(elems: List[Element], kws: List[String], syms: List[String]): StringPair =
  match elems {
    .nil => StringPair.mk(kws, syms),
    .cons(elem, rest) => {
      let pair = collect_tokens_from_element(elem, kws, syms);
      match pair { .mk(kws2, syms2) =>
        collect_tokens_from_elements(rest, kws2, syms2)
      }
    }
  }

fn collect_tokens_from_element(elem: Element, kws: List[String], syms: List[String]): StringPair =
  match elem {
    .token(t) =>
      match t {
        .keyword(k) => StringPair.mk(List.cons(k, kws), syms),
        .symbol(s) => StringPair.mk(kws, List.cons(s, syms)),
        .named(n) => StringPair.mk(kws, syms)
      },
    .node(ref) => StringPair.mk(kws, syms),
    .labeled(label, inner) => collect_tokens_from_element(inner, kws, syms),
    .optional(inner) => collect_tokens_from_element(inner, kws, syms),
    .repeated(inner) => collect_tokens_from_element(inner, kws, syms),
    .group(elems) => collect_tokens_from_elements(elems, kws, syms)
  }

// ---------------------------------------------------------------------------
// String utilities: dedupe and sort
// ---------------------------------------------------------------------------

fn dedupe_strings(xs: List[String]): List[String] =
  dedupe_strings_acc(xs, List.nil)

fn dedupe_strings_acc(xs: List[String], acc: List[String]): List[String] =
  match xs {
    .nil => acc,
    .cons(x, rest) =>
      if list_contains_string(acc, x) { dedupe_strings_acc(rest, acc) }
      else { dedupe_strings_acc(rest, List.cons(x, acc)) }
  }

// Simple insertion sort for strings
fn sort_strings(xs: List[String]): List[String] =
  sort_strings_acc(xs, List.nil)

fn sort_strings_acc(xs: List[String], sorted: List[String]): List[String] =
  match xs {
    .nil => sorted,
    .cons(x, rest) => sort_strings_acc(rest, insert_sorted(x, sorted))
  }

fn insert_sorted(s: String, xs: List[String]): List[String] =
  match xs {
    .nil => List.cons(s, xs),
    .cons(x, rest) =>
      if string_lt(s, x) { List.cons(s, xs) }
      else { List.cons(x, insert_sorted(s, rest)) }
  }

fn string_lt(s1: String, s2: String): Bool =
  string_lt_loop(s1, s2, 0)

fn string_lt_loop(s1: String, s2: String, idx: Number): Bool =
  if idx >= s1.len() {
    if idx >= s2.len() { Bool.false } else { Bool.true }
  } else if idx >= s2.len() { Bool.false }
  else {
    let ca = s1.char_code_at(idx);
    let cb = s2.char_code_at(idx);
    if ca < cb { Bool.true }
    else if cb < ca { Bool.false }
    else { string_lt_loop(s1, s2, idx + 1) }
  }

// Check if rule alternatives are all token literals
fn is_token_only_alternatives(alts: List[Alternative]): Bool =
  match alts {
    .nil => Bool.true,
    .cons(alt, rest) =>
      match alt { .mk(name) => {
        // Simple heuristic: if name starts with lowercase or has symbols, it's a token
        // For now, we check if the name matches a known token pattern
        // Actually we need to check if all alternatives are quoted in the grammar
        // Since our parser resolves them, we can check if name looks like a reference
        // to a sequence rule. For now, treat as token-only if name has no uppercase start.
        let code = name.char_code_at(0);
        let is_upper = if code >= 65 { code <= 90 } else { Bool.false };
        if is_upper { Bool.false } else { is_token_only_alternatives(rest) }
      }}
  }

// ---------------------------------------------------------------------------
// Generate syntax_kind.rs
// ---------------------------------------------------------------------------

fn generate_syntax_kind(grammar: Grammar): String {
  let collected = collect_tokens(grammar);
  match collected { .mk(keywords, symbols) =>
  match grammar { .mk(token_defs, attrs, rules) => {
    let s = "// Auto-generated by langue. Do not edit.\n";
    let s = s + "// Regenerate: scripts/gen_langue.sh\n\n";
    let s = s + "#[allow(non_camel_case_types)]\n";
    let s = s + "#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n";
    let s = s + "#[repr(u16)]\n";
    let s = s + "pub enum SyntaxKind {\n";
    // Named tokens
    let s = s + "    // Named tokens\n";
    let s = emit_named_tokens(s, token_defs);
    // Trivia
    let s = s + "    // Trivia\n";
    let s = s + "    WHITESPACE,\n    NEWLINE,\n    UNKNOWN,\n";
    // Keywords
    let s = emit_keywords(s, keywords);
    // Symbols
    let s = emit_symbols(s, symbols);
    // Nodes
    let s = s + "    // Nodes\n";
    let s = emit_node_kinds(s, rules);
    // Sentinel
    let s = s + "    // Sentinel\n    ERROR,\n";
    let s = s + "}\n";
    // impl block
    let s = s + "\nimpl SyntaxKind {\n";
    let s = s + "    pub fn is_trivia(self) -> bool {\n";
    let s = s + "        matches!(self, Self::WHITESPACE | Self::NEWLINE)\n";
    let s = s + "    }\n";
    // from_keyword
    let s = emit_from_keyword(s, keywords);
    // from_symbol
    let s = emit_from_symbol(s, symbols);
    let s = s + "}\n";
    s
  }}}
}

fn emit_named_tokens(s: String, tokens: List[String]): String =
  match tokens {
    .nil => s,
    .cons(tok, rest) =>
      emit_named_tokens(s + "    " + to_screaming_snake(tok) + ",\n", rest)
  }

fn emit_keywords(s: String, kws: List[String]): String =
  match kws {
    .nil => s,
    _ => {
      let s2 = s + "    // Keywords\n";
      emit_keywords_items(s2, kws)
    }
  }

fn emit_keywords_items(s: String, kws: List[String]): String =
  match kws {
    .nil => s,
    .cons(kw, rest) => {
      let line = "    " + keyword_variant(kw) + ", // '" + kw + "'\n";
      emit_keywords_items(s + line, rest)
    }
  }

fn emit_symbols(s: String, syms: List[String]): String =
  match syms {
    .nil => s,
    .cons(sym, rest) => {
      let s2 = match rest { .nil => s, _ => match syms { _ => s + "    // Symbols\n" } };
      emit_symbols_items(s2, syms)
    }
  }

fn emit_symbols_items(s: String, syms: List[String]): String =
  match syms {
    .nil => s,
    .cons(sym, rest) => {
      let line = "    " + symbol_variant(sym) + ", // '" + sym + "'\n";
      emit_symbols_items(s + line, rest)
    }
  }

fn emit_node_kinds(s: String, rules: List[Rule]): String =
  match rules {
    .nil => s,
    .cons(rule, rest) =>
      match rule { .mk(name, body) =>
        match body {
          .sequence(elems) => {
            let line = "    " + to_screaming_snake(name) + ", // " + name + "\n";
            emit_node_kinds(s + line, rest)
          },
          .alternatives(alts) =>
            if is_token_only_alternatives(alts) {
              let line = "    " + to_screaming_snake(name) + ", // " + name + " (token wrapper)\n";
              emit_node_kinds(s + line, rest)
            } else {
              // Alternative-only rules don't get SyntaxKind variants — the rule is an enum
              emit_node_kinds(s, rest)
            },
          .pratt(atom_names, alts) => {
            // Each named pratt alt gets its own SyntaxKind variant; the rule itself is an enum
            let s2 = emit_pratt_alt_kinds(s, alts);
            emit_node_kinds(s2, rest)
          }
        }
      }
  }

fn emit_pratt_alt_kinds(s: String, alts: List[PrattAlt]): String =
  emit_pratt_alt_kinds_dedup(s, alts, List.nil)

fn emit_pratt_alt_kinds_dedup(s: String, alts: List[PrattAlt], seen: List[String]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        if list_contains_string(seen, name) {
          emit_pratt_alt_kinds_dedup(s, rest, seen)
        } else {
          let line = "    " + to_screaming_snake(name) + ", // " + name + "\n";
          emit_pratt_alt_kinds_dedup(s + line, rest, List.cons(name, seen))
        }
      }
  }

fn emit_from_keyword(s: String, kws: List[String]): String =
  match kws {
    .nil => s,
    _ => {
      let s = s + "\n    pub fn from_keyword(text: &str) -> Option<Self> {\n";
      let s = s + "        match text {\n";
      let s = emit_keyword_arms(s, kws);
      let s = s + "            _ => None,\n";
      let s = s + "        }\n";
      let s = s + "    }\n";
      s
    }
  }

fn emit_keyword_arms(s: String, kws: List[String]): String =
  match kws {
    .nil => s,
    .cons(kw, rest) => {
      let line = "            \"" + kw + "\" => Some(Self::" + keyword_variant(kw) + "),\n";
      emit_keyword_arms(s + line, rest)
    }
  }

fn emit_from_symbol(s: String, syms: List[String]): String =
  match syms {
    .nil => s,
    _ => {
      let s = s + "\n    pub fn from_symbol(text: &str) -> Option<Self> {\n";
      let s = s + "        match text {\n";
      let s = emit_symbol_arms(s, syms);
      let s = s + "            _ => None,\n";
      let s = s + "        }\n";
      let s = s + "    }\n";
      s
    }
  }

fn emit_symbol_arms(s: String, syms: List[String]): String =
  match syms {
    .nil => s,
    .cons(sym, rest) => {
      let line = "            \"" + sym + "\" => Some(Self::" + symbol_variant(sym) + "),\n";
      emit_symbol_arms(s + line, rest)
    }
  }

// ---------------------------------------------------------------------------
// Generate ast.rs
// ---------------------------------------------------------------------------

fn generate_ast(grammar: Grammar): String =
  match grammar { .mk(token_defs, attrs, rules) => {
    let s = "// Auto-generated by langue. Do not edit.\n";
    let s = s + "// Regenerate: scripts/gen_langue.sh\n\n";
    let s = s + "use super::SyntaxKind;\n";
    let s = s + "use super::{SyntaxNode, SyntaxElement, LosslessToken};\n\n";
    let s = s + "pub trait AstNode<'a>: Sized {\n";
    let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self>;\n";
    let s = s + "    fn syntax(&self) -> &'a SyntaxNode;\n";
    let s = s + "}\n\n";
    emit_ast_rules(s, token_defs, rules)
  }}

fn emit_ast_rules(s: String, token_defs: List[String], rules: List[Rule]): String =
  match rules {
    .nil => s,
    .cons(rule, rest) =>
      match rule { .mk(name, body) => {
        let s2 = match body {
          .sequence(elems) => emit_struct_node(s, name, elems, token_defs),
          .alternatives(alts) =>
            if is_token_only_alternatives(alts) { emit_token_wrapper_node(s, name) }
            else { emit_enum_node(s, name, alts) },
          .pratt(atom_names, alts) => emit_pratt_rule(s, name, atom_names, alts, token_defs)
        };
        emit_ast_rules(s2, token_defs, rest)
      }}
  }

// Emit struct nodes for each pratt alt, plus an enum combining atoms + alts
fn emit_pratt_rule(s: String, rule_name: String, atom_names: List[String], alts: List[PrattAlt], token_defs: List[String]): String {
  let s2 = emit_pratt_alt_structs(s, alts, token_defs);
  let all_names = list_concat_string(atom_names, collect_pratt_alt_names(alts));
  emit_enum_from_names(s2, rule_name, all_names)
}

fn emit_pratt_alt_structs(s: String, alts: List[PrattAlt], token_defs: List[String]): String =
  emit_pratt_alt_structs_dedup(s, alts, token_defs, List.nil)

fn emit_pratt_alt_structs_dedup(s: String, alts: List[PrattAlt], token_defs: List[String], seen: List[String]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        if list_contains_string(seen, name) {
          emit_pratt_alt_structs_dedup(s, rest, token_defs, seen)
        } else {
          let s2 = emit_struct_node(s, name, elems, token_defs);
          emit_pratt_alt_structs_dedup(s2, rest, token_defs, List.cons(name, seen))
        }
      }
  }

fn collect_pratt_alt_names(alts: List[PrattAlt]): List[String] =
  collect_pratt_alt_names_dedup(alts, List.nil)

fn collect_pratt_alt_names_dedup(alts: List[PrattAlt], seen: List[String]): List[String] =
  match alts {
    .nil => List.nil,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        if list_contains_string(seen, name) {
          collect_pratt_alt_names_dedup(rest, seen)
        } else {
          List.cons(name, collect_pratt_alt_names_dedup(rest, List.cons(name, seen)))
        }
      }
  }

fn emit_enum_from_names(s: String, enum_name: String, names: List[String]): String {
  let s = s + "pub enum " + enum_name + "<'a> {\n";
  let s = emit_variants_from_names(s, names);
  let s = s + "}\n\n";
  let s = s + "impl<'a> AstNode<'a> for " + enum_name + "<'a> {\n";
  let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self> {\n";
  let s = s + "        None\n";
  let s = emit_cast_chain_from_names(s, names);
  let s = s + "    }\n";
  let s = s + "    fn syntax(&self) -> &'a SyntaxNode {\n";
  let s = s + "        match self {\n";
  let s = emit_syntax_arms_from_names(s, names);
  let s = s + "        }\n";
  let s = s + "    }\n";
  s + "}\n\n"
}

fn emit_variants_from_names(s: String, names: List[String]): String =
  match names {
    .nil => s,
    .cons(name, rest) =>
      emit_variants_from_names(s + "    " + name + "(" + name + "<'a>),\n", rest)
  }

fn emit_cast_chain_from_names(s: String, names: List[String]): String =
  match names {
    .nil => s,
    .cons(name, rest) => {
      let line = "            .or_else(|| " + name + "::cast(node).map(Self::" + name + "))\n";
      emit_cast_chain_from_names(s + line, rest)
    }
  }

fn emit_syntax_arms_from_names(s: String, names: List[String]): String =
  match names {
    .nil => s,
    .cons(name, rest) => {
      let line = "            Self::" + name + "(n) => n.syntax(),\n";
      emit_syntax_arms_from_names(s + line, rest)
    }
  }

// Struct node for sequence rules
fn emit_struct_node(s: String, name: String, elems: List[Element], token_defs: List[String]): String {
  let kind = to_screaming_snake(name);
  let s = s + "pub struct " + name + "<'a>(pub(crate) &'a SyntaxNode);\n\n";
  let s = s + "impl<'a> AstNode<'a> for " + name + "<'a> {\n";
  let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self> {\n";
  let s = s + "        (node.kind == SyntaxKind::" + kind + ").then(|| Self(node))\n";
  let s = s + "    }\n";
  let s = s + "    fn syntax(&self) -> &'a SyntaxNode { self.0 }\n";
  let s = s + "}\n\n";
  // Accessor methods
  emit_accessors(s, name, elems, token_defs)
}

fn emit_accessors(s: String, struct_name: String, elems: List[Element], token_defs: List[String]): String {
  let has_labeled = has_labeled_elements(elems);
  if has_labeled {
    let s = s + "impl<'a> " + struct_name + "<'a> {\n";
    let s = emit_accessors_for_elements(s, elems, token_defs);
    let s = s + "}\n\n";
    s
  } else { s }
}

fn has_labeled_elements(elems: List[Element]): Bool =
  match elems {
    .nil => Bool.false,
    .cons(elem, rest) =>
      match elem {
        .labeled(_, _) => Bool.true,
        _ => has_labeled_elements(rest)
      }
  }

fn emit_accessors_for_elements(s: String, elems: List[Element], token_defs: List[String]): String =
  match elems {
    .nil => s,
    .cons(elem, rest) =>
      match elem {
        .labeled(label, inner) => {
          let s2 = emit_single_accessor(s, label, inner, token_defs);
          emit_accessors_for_elements(s2, rest, token_defs)
        },
        _ => emit_accessors_for_elements(s, rest, token_defs)
      }
  }

// Emit a single accessor method for a labeled element
fn emit_single_accessor(s: String, label: String, elem: Element, token_defs: List[String]): String =
  match elem {
    .token(t) => emit_token_accessor(s, label, t, Bool.false),
    .node(n) =>
      match n { .mk(name) =>
        if list_contains_string(token_defs, name) { emit_token_accessor(s, label, TokenRef.named(name), Bool.false) }
        else { emit_node_accessor(s, label, name, Bool.false) }
      },
    .optional(inner) => emit_single_accessor(s, label, inner, token_defs),
    .repeated(inner) => emit_single_accessor_repeated(s, label, inner, token_defs),
    .labeled(_, inner) => emit_single_accessor(s, label, inner, token_defs),
    .group(elems) => s
  }

fn emit_single_accessor_repeated(s: String, label: String, elem: Element, token_defs: List[String]): String =
  match elem {
    .token(t) => emit_token_accessor(s, label, t, Bool.true),
    .node(n) =>
      match n { .mk(name) =>
        if list_contains_string(token_defs, name) { emit_token_accessor(s, label, TokenRef.named(name), Bool.true) }
        else { emit_node_accessor(s, label, name, Bool.true) }
      },
    .optional(inner) => emit_single_accessor_repeated(s, label, inner, token_defs),
    .repeated(inner) => emit_single_accessor_repeated(s, label, inner, token_defs),
    .labeled(_, inner) => emit_single_accessor_repeated(s, label, inner, token_defs),
    .group(elems) => s
  }

fn token_kind_from_ref(t: TokenRef): String =
  match t {
    .named(name) => to_screaming_snake(name),
    .keyword(kw) => keyword_variant(kw),
    .symbol(sym) => symbol_variant(sym)
  }

fn emit_token_accessor(s: String, label: String, t: TokenRef, repeated: Bool): String {
  let kind = token_kind_from_ref(t);
  if repeated {
    let s = s + "    pub fn " + label + "(&self) -> impl Iterator<Item = &'a LosslessToken> + 'a {\n";
    let s = s + "        self.0.children.iter().filter_map(|c| match c {\n";
    let s = s + "            SyntaxElement::Token(t) if t.kind == SyntaxKind::" + kind + " => Some(t),\n";
    let s = s + "            _ => None,\n";
    let s = s + "        })\n";
    s + "    }\n"
  } else {
    let s = s + "    pub fn " + label + "(&self) -> Option<&'a LosslessToken> {\n";
    let s = s + "        self.0.children.iter().find_map(|c| match c {\n";
    let s = s + "            SyntaxElement::Token(t) if t.kind == SyntaxKind::" + kind + " => Some(t),\n";
    let s = s + "            _ => None,\n";
    let s = s + "        })\n";
    s + "    }\n"
  }
}

fn emit_node_accessor(s: String, label: String, node_name: String, repeated: Bool): String =
  if repeated {
    let s = s + "    pub fn " + label + "(&self) -> impl Iterator<Item = " + node_name + "<'a>> + 'a {\n";
    let s = s + "        self.0.children.iter().filter_map(|c| match c {\n";
    let s = s + "            SyntaxElement::Node(n) => " + node_name + "::cast(n),\n";
    let s = s + "            _ => None,\n";
    let s = s + "        })\n";
    s + "    }\n"
  } else {
    let s = s + "    pub fn " + label + "(&self) -> Option<" + node_name + "<'a>> {\n";
    let s = s + "        self.0.children.iter().find_map(|c| match c {\n";
    let s = s + "            SyntaxElement::Node(n) => " + node_name + "::cast(n),\n";
    let s = s + "            _ => None,\n";
    let s = s + "        })\n";
    s + "    }\n"
  }

// Enum node for alternative rules
fn emit_enum_node(s: String, name: String, alts: List[Alternative]): String {
  // enum definition
  let s = s + "pub enum " + name + "<'a> {\n";
  let s = emit_enum_variants(s, alts);
  let s = s + "}\n\n";
  // AstNode impl
  let s = s + "impl<'a> AstNode<'a> for " + name + "<'a> {\n";
  let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self> {\n";
  let s = s + "        None\n";
  let s = emit_enum_cast_chain(s, alts);
  let s = s + "    }\n";
  let s = s + "    fn syntax(&self) -> &'a SyntaxNode {\n";
  let s = s + "        match self {\n";
  let s = emit_enum_syntax_arms(s, alts);
  let s = s + "        }\n";
  let s = s + "    }\n";
  let s = s + "}\n\n";
  s
}

fn emit_enum_variants(s: String, alts: List[Alternative]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name) =>
        emit_enum_variants(s + "    " + name + "(" + name + "<'a>),\n", rest)
      }
  }

fn emit_enum_cast_chain(s: String, alts: List[Alternative]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name) => {
        let line = "            .or_else(|| " + name + "::cast(node).map(Self::" + name + "))\n";
        emit_enum_cast_chain(s + line, rest)
      }}
  }

fn emit_enum_syntax_arms(s: String, alts: List[Alternative]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name) => {
        let line = "            Self::" + name + "(n) => n.syntax(),\n";
        emit_enum_syntax_arms(s + line, rest)
      }}
  }

// ---------------------------------------------------------------------------
// Generate lossless.rs parser (recursive-descent + Pratt)
// ---------------------------------------------------------------------------

fn generate_parser(grammar: Grammar): String =
  match grammar { .mk(token_defs, attrs, rules) => {
    let s = "// Auto-generated by langue. Do not edit.\n";
    let s = s + "// Regenerate: scripts/gen_langue.sh\n\n";
    let s = s + "use lumo_lexer::{lex_lossless, Keyword, LosslessTokenKind as LexKind};\n";
    let s = s + "use lumo_span::Span;\n\n";
    let s = s + "use crate::syntax_kind::SyntaxKind;\n\n";
    let s = emit_parser_boilerplate(s);
    let s = emit_parser_impl(s, token_defs, rules);
    s
  }}

fn emit_parser_boilerplate(s: String): String {
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub struct ParseError {\n    pub span: Span,\n    pub message: String,\n}\n\n";
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub struct LosslessToken {\n    pub kind: SyntaxKind,\n    pub span: Span,\n    pub text: String,\n}\n\n";
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub enum SyntaxElement {\n    Node(Box<SyntaxNode>),\n    Token(LosslessToken),\n}\n\n";
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub struct SyntaxNode {\n    pub kind: SyntaxKind,\n    pub span: Span,\n    pub children: Vec<SyntaxElement>,\n}\n\n";
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub struct ParseOutput {\n    pub root: SyntaxNode,\n    pub errors: Vec<ParseError>,\n}\n\n";
  let s = s + "pub fn parse(source: &str) -> ParseOutput {\n";
  let s = s + "    let lexed = lex_lossless(source);\n";
  let s = s + "    let mut p = Parser { tokens: lexed.tokens, index: 0, errors: Vec::new() };\n";
  let s = s + "    let root = p.parse_file();\n";
  let s = s + "    ParseOutput { root, errors: p.errors }\n}\n\n";
  let s = s + "pub fn node_text(node: &SyntaxNode) -> String {\n";
  let s = s + "    let mut out = String::new();\n";
  let s = s + "    write_node_text(node, &mut out);\n";
  let s = s + "    out\n}\n\n";
  let s = s + "fn write_node_text(node: &SyntaxNode, out: &mut String) {\n";
  let s = s + "    for child in &node.children {\n";
  let s = s + "        match child {\n";
  let s = s + "            SyntaxElement::Node(n) => write_node_text(n, out),\n";
  let s = s + "            SyntaxElement::Token(t) => out.push_str(&t.text),\n";
  let s = s + "        }\n    }\n}\n\n";
  let s = s + "fn node_from_children(kind: SyntaxKind, children: Vec<SyntaxElement>) -> SyntaxNode {\n";
  let s = s + "    let span = children_span(&children);\n";
  let s = s + "    SyntaxNode { kind, span, children }\n}\n\n";
  let s = s + "fn children_span(children: &[SyntaxElement]) -> Span {\n";
  let s = s + "    let start = children.iter().find_map(|c| match c {\n";
  let s = s + "        SyntaxElement::Token(t) => Some(t.span.start),\n";
  let s = s + "        SyntaxElement::Node(n) => if n.children.is_empty() { None } else { Some(n.span.start) },\n";
  let s = s + "    }).unwrap_or(0);\n";
  let s = s + "    let end = children.iter().rev().find_map(|c| match c {\n";
  let s = s + "        SyntaxElement::Token(t) => Some(t.span.end),\n";
  let s = s + "        SyntaxElement::Node(n) => if n.children.is_empty() { None } else { Some(n.span.end) },\n";
  let s = s + "    }).unwrap_or(0);\n";
  let s = s + "    Span::new(start, end)\n}\n\n";
  let s = s + "fn lexer_token_to_lst(t: lumo_lexer::LosslessToken) -> LosslessToken {\n";
  let s = s + "    LosslessToken { kind: lexer_kind_to_syntax_kind(&t.kind, &t.text), span: t.span, text: t.text }\n}\n\n";
  emit_lexer_kind_map(s)
}

fn emit_lexer_kind_map(s: String): String {
  let s = s + "fn lexer_kind_to_syntax_kind(kind: &LexKind, text: &str) -> SyntaxKind {\n";
  let s = s + "    match kind {\n";
  let s = s + "        LexKind::Ident => SyntaxKind::IDENT,\n";
  let s = s + "        LexKind::StringLit => SyntaxKind::STRING_LIT,\n";
  let s = s + "        LexKind::NumberLit => SyntaxKind::NUMBER_LIT,\n";
  let s = s + "        LexKind::Whitespace => SyntaxKind::WHITESPACE,\n";
  let s = s + "        LexKind::Newline => SyntaxKind::NEWLINE,\n";
  let s = s + "        LexKind::Unknown => SyntaxKind::UNKNOWN,\n";
  let s = s + "        LexKind::Keyword(kw) => match kw {\n";
  let s = s + "            Keyword::Data => SyntaxKind::DATA_KW,\n";
  let s = s + "            Keyword::Fn => SyntaxKind::FN_KW,\n";
  let s = s + "            Keyword::Extern => SyntaxKind::EXTERN_KW,\n";
  let s = s + "            Keyword::Let => SyntaxKind::LET_KW,\n";
  let s = s + "            Keyword::In => SyntaxKind::IN_KW,\n";
  let s = s + "            Keyword::Thunk => SyntaxKind::THUNK_KW,\n";
  let s = s + "            Keyword::Force => SyntaxKind::FORCE_KW,\n";
  let s = s + "            Keyword::Match => SyntaxKind::MATCH_KW,\n";
  let s = s + "            Keyword::Cap => SyntaxKind::CAP_KW,\n";
  let s = s + "            Keyword::Handle => SyntaxKind::HANDLE_KW,\n";
  let s = s + "            Keyword::Bundle => SyntaxKind::BUNDLE_KW,\n";
  let s = s + "            Keyword::Use => SyntaxKind::USE_KW,\n";
  let s = s + "            Keyword::Impl => SyntaxKind::IMPL_KW,\n";
  let s = s + "            Keyword::If => SyntaxKind::IF_KW,\n";
  let s = s + "            Keyword::Else => SyntaxKind::ELSE_KW,\n";
  let s = s + "            _ => SyntaxKind::UNKNOWN,\n";
  let s = s + "        },\n";
  let s = s + "        LexKind::Symbol(_) => SyntaxKind::from_symbol(text).unwrap_or(SyntaxKind::UNKNOWN),\n";
  let s = s + "    }\n}\n\n";
  s
}

fn emit_parser_struct(s: String): String {
  let s = s + "struct Parser {\n";
  let s = s + "    tokens: Vec<lumo_lexer::LosslessToken>,\n";
  let s = s + "    index: usize,\n";
  let s = s + "    errors: Vec<ParseError>,\n";
  let s = s + "}\n\n";
  s
}

fn emit_parser_helpers(s: String): String {
  let s = s + "impl Parser {\n";
  let s = s + "    fn eof(&self) -> bool { self.index >= self.tokens.len() }\n";
  let s = s + "    fn current(&self) -> Option<&lumo_lexer::LosslessToken> { self.tokens.get(self.index) }\n";
  let s = s + "    fn bump(&mut self) -> Option<LosslessToken> {\n";
  let s = s + "        let token = self.tokens.get(self.index).cloned();\n";
  let s = s + "        if token.is_some() { self.index += 1; }\n";
  let s = s + "        token.map(lexer_token_to_lst)\n";
  let s = s + "    }\n";
  let s = s + "    fn is_trivia_lex(kind: &LexKind) -> bool {\n";
  let s = s + "        matches!(kind, LexKind::Whitespace | LexKind::Newline)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_trivia(&self) -> bool {\n";
  let s = s + "        self.current().map(|t| Self::is_trivia_lex(&t.kind)).unwrap_or(false)\n";
  let s = s + "    }\n";
  let s = s + "    fn skip_trivia_into(&mut self, children: &mut Vec<SyntaxElement>) {\n";
  let s = s + "        while self.at_trivia() { children.push(SyntaxElement::Token(self.bump().unwrap())); }\n";
  let s = s + "    }\n";
  let s = s + "    fn peek_non_trivia_token(&self, n: usize) -> Option<&lumo_lexer::LosslessToken> {\n";
  let s = s + "        let mut count = 0; let mut i = self.index;\n";
  let s = s + "        while i < self.tokens.len() {\n";
  let s = s + "            let tok = &self.tokens[i];\n";
  let s = s + "            if !Self::is_trivia_lex(&tok.kind) {\n";
  let s = s + "                if count == n { return Some(tok); }\n";
  let s = s + "                count += 1;\n";
  let s = s + "            }\n";
  let s = s + "            i += 1;\n";
  let s = s + "        }\n";
  let s = s + "        None\n";
  let s = s + "    }\n";
  let s = s + "    fn at_keyword(&self, kw: Keyword) -> bool {\n";
  let s = s + "        matches!(self.current().map(|t| &t.kind), Some(LexKind::Keyword(actual)) if *actual == kw)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_keyword(&self, kw: Keyword) -> bool {\n";
  let s = s + "        matches!(self.peek_non_trivia_token(0).map(|t| &t.kind), Some(LexKind::Keyword(actual)) if *actual == kw)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_symbol(&self, text: &str) -> bool {\n";
  let s = s + "        self.peek_non_trivia_token(0).map(|t| t.text.as_str()) == Some(text)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_ident(&self) -> bool {\n";
  let s = s + "        matches!(self.peek_non_trivia_token(0).map(|t| &t.kind), Some(LexKind::Ident))\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_ident_text(&self, text: &str) -> bool {\n";
  let s = s + "        matches!(self.peek_non_trivia_token(0), Some(tok) if matches!(tok.kind, LexKind::Ident) && tok.text == text)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_ident(&self) -> bool {\n";
  let s = s + "        matches!(self.current().map(|t| &t.kind), Some(LexKind::Ident))\n";
  let s = s + "    }\n";
  let s = s + "    fn at_symbol_text(&self, text: &str) -> bool {\n";
  let s = s + "        self.current().map(|t| t.text.as_str()) == Some(text)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_trivia_or_unknown(&self) -> bool {\n";
  let s = s + "        self.current().map(|t| matches!(t.kind, LexKind::Whitespace | LexKind::Newline | LexKind::Unknown)).unwrap_or(false)\n";
  let s = s + "    }\n";
  let s = s + "    fn error_here(&mut self, message: &str) {\n";
  let s = s + "        let span = self.current().map(|t| t.span).unwrap_or(Span::new(0, 0));\n";
  let s = s + "        self.errors.push(ParseError { span, message: message.to_owned() });\n";
  let s = s + "    }\n";
  let s = s + "    fn expect_keyword(&mut self, kw: Keyword, children: &mut Vec<SyntaxElement>) {\n";
  let s = s + "        self.skip_trivia_into(children);\n";
  let s = s + "        if self.at_keyword(kw) { children.push(SyntaxElement::Token(self.bump().unwrap())); }\n";
  let s = s + "        else { self.error_here(\"expected keyword\"); }\n";
  let s = s + "    }\n";
  let s = s + "    fn expect_symbol(&mut self, sym: &str, children: &mut Vec<SyntaxElement>) {\n";
  let s = s + "        self.skip_trivia_into(children);\n";
  let s = s + "        if self.at_symbol_text(sym) { children.push(SyntaxElement::Token(self.bump().unwrap())); }\n";
  let s = s + "        else { self.error_here(&format!(\"expected '{}'\", sym)); }\n";
  let s = s + "    }\n";
  let s = s + "    fn expect_ident(&mut self, children: &mut Vec<SyntaxElement>) {\n";
  let s = s + "        self.skip_trivia_into(children);\n";
  let s = s + "        if self.at_ident() { children.push(SyntaxElement::Token(self.bump().unwrap())); }\n";
  let s = s + "        else { self.error_here(\"expected identifier\"); }\n";
  let s = s + "    }\n";
  s + "}\n\n"
}

fn emit_parser_impl(s: String, token_defs: List[String], rules: List[Rule]): String {
  let s = emit_parser_struct(s);
  let s = emit_parser_helpers(s);
  let s = s + "impl Parser {\n";
  let s = emit_parse_rules(s, token_defs, rules);
  s + "}\n"
}

fn emit_parse_rules(s: String, token_defs: List[String], rules: List[Rule]): String =
  match rules {
    .nil => s,
    .cons(rule, rest) =>
      match rule { .mk(name, body) => {
        let s2 = emit_can_parse_method(s, name, body, token_defs);
        let s3 = emit_parse_rule(s2, name, body, token_defs);
        emit_parse_rules(s3, token_defs, rest)
      }}
  }

// Emit `fn can_parse_X(&self) -> bool` lookahead predicate
fn emit_can_parse_method(s: String, name: String, body: RuleBody, token_defs: List[String]): String {
  let fn_name = "can_parse_" + to_snake(name);
  let cond = make_body_lookahead(body, token_defs);
  s + "    fn " + fn_name + "(&self) -> bool { " + cond + " }\n"
}

fn make_body_lookahead(body: RuleBody, token_defs: List[String]): String =
  match body {
    .sequence(elems) => make_first_elem_lookahead(elems, token_defs),
    .alternatives(alts) => make_alts_lookahead(alts),
    .pratt(atom_names, alts) => make_pratt_lookahead(atom_names, alts)
  }

fn make_first_elem_lookahead(elems: List[Element], token_defs: List[String]): String =
  match elems {
    .nil => "false",
    .cons(elem, rest) => {
      let core = unwrap_labeled_elem(elem);
      match core {
        .optional(inner) => make_first_elem_lookahead(rest, token_defs),
        .repeated(inner) => make_first_elem_lookahead(rest, token_defs),
        _ => make_element_lookahead(elem, token_defs)
      }
    }
  }

fn unwrap_labeled_elem(elem: Element): Element =
  match elem {
    .labeled(label, inner) => inner,
    _ => elem
  }

fn make_alts_lookahead(alts: List[Alternative]): String =
  match alts {
    .nil => "false",
    .cons(alt, rest) =>
      match alt { .mk(alt_name) => {
        let cond = "self.can_parse_" + to_snake(alt_name) + "()";
        match rest {
          .nil => cond,
          _ => cond + " || " + make_alts_lookahead(rest)
        }
      }}
  }

fn make_pratt_lookahead(atom_names: List[String], alts: List[PrattAlt]): String {
  let prefix_cond = make_prefix_alts_lookahead(alts);
  let atom_cond = make_atoms_lookahead(atom_names);
  if prefix_cond == "" { atom_cond }
  else if atom_cond == "false" { prefix_cond }
  else { prefix_cond + " || " + atom_cond }
}

fn make_prefix_alts_lookahead(alts: List[PrattAlt]): String =
  match alts {
    .nil => "",
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        match bp { .mk(lbp, rbp) =>
          match lbp {
            .num(_) => make_prefix_alts_lookahead(rest),
            .none => {
              let cond = "self.at_pratt_" + to_snake(name) + "()";
              let rest_cond = make_prefix_alts_lookahead(rest);
              if rest_cond == "" { cond }
              else { cond + " || " + rest_cond }
            }
          }
        }
      }
  }

fn make_atoms_lookahead(atom_names: List[String]): String =
  match atom_names {
    .nil => "false",
    .cons(name, rest) => {
      let cond = "self.can_parse_" + to_snake(name) + "()";
      match rest {
        .nil => cond,
        _ => cond + " || " + make_atoms_lookahead(rest)
      }
    }
  }

fn emit_parse_rule(s: String, name: String, body: RuleBody, token_defs: List[String]): String =
  match body {
    .sequence(elems) => emit_parse_sequence_rule(s, name, elems, token_defs),
    .alternatives(alts) =>
      if is_token_only_alternatives(alts) { s }
      else { emit_parse_alt_rule(s, name, alts) },
    .pratt(atom_names, alts) => emit_parse_pratt_rule(s, name, atom_names, alts, token_defs)
  }

fn emit_parse_sequence_rule(s: String, name: String, elems: List[Element], token_defs: List[String]): String =
  if name == "File" { emit_parse_file_with_recovery(s) }
  else {
    let fn_name = "parse_" + to_snake(name);
    let kind = to_screaming_snake(name);
    let s = s + "    fn " + fn_name + "(&mut self) -> SyntaxNode {\n";
    let s = s + "        let mut children = Vec::new();\n";
    let s = emit_parse_elements(s, elems, token_defs, "        ");
    let s = s + "        node_from_children(SyntaxKind::" + kind + ", children)\n";
    s + "    }\n\n"
  }

// Entry rule: consumes ALL tokens via error recovery so the lossless tree is always complete.
fn emit_parse_file_with_recovery(s: String): String {
  let s = s + "    fn parse_file(&mut self) -> SyntaxNode {\n";
  let s = s + "        let mut children = Vec::new();\n";
  let s = s + "        while !self.eof() {\n";
  let s = s + "            self.skip_trivia_into(&mut children);\n";
  let s = s + "            if self.eof() { break; }\n";
  let s = s + "            if self.can_parse_item() {\n";
  let s = s + "                children.push(SyntaxElement::Node(Box::new(self.parse_item())));\n";
  let s = s + "            } else {\n";
  let s = s + "                children.push(SyntaxElement::Node(Box::new(\n";
  let s = s + "                    node_from_children(SyntaxKind::ERROR, vec![SyntaxElement::Token(self.bump().unwrap())])\n";
  let s = s + "                )));\n";
  let s = s + "            }\n";
  let s = s + "        }\n";
  s + "        node_from_children(SyntaxKind::FILE, children)\n    }\n\n"
}

fn emit_parse_alt_rule(s: String, name: String, alts: List[Alternative]): String {
  let fn_name = "parse_" + to_snake(name);
  let s = s + "    fn " + fn_name + "(&mut self) -> SyntaxNode {\n";
  let s = emit_alt_dispatch(s, alts, "        ");
  let s = s + "        self.error_here(\"expected " + name + "\");\n";
  let s = s + "        node_from_children(SyntaxKind::ERROR, Vec::new())\n";
  s + "    }\n\n"
}

fn emit_alt_dispatch(s: String, alts: List[Alternative], indent: String): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(alt_name) => {
        let cond = make_alt_lookahead(alt_name);
        let call = "self.parse_" + to_snake(alt_name) + "()";
        let s2 = s + indent + "if " + cond + " { return " + call + "; }\n";
        emit_alt_dispatch(s2, rest, indent)
      }}
  }

fn make_alt_lookahead(name: String): String =
  "self.can_parse_" + to_snake(name) + "()"

fn emit_parse_pratt_rule(s: String, name: String, atom_names: List[String], alts: List[PrattAlt], token_defs: List[String]): String {
  let fn_name = "parse_" + to_snake(name);
  let s = s + "    fn " + fn_name + "(&mut self) -> SyntaxNode {\n";
  let s = s + "        self." + fn_name + "_bp(0)\n";
  let s = s + "    }\n\n";
  let s = s + "    fn " + fn_name + "_bp(&mut self, min_bp: u8) -> SyntaxNode {\n";
  let s = s + "        let mut lhs = self." + fn_name + "_atom();\n";
  let s = emit_pratt_loop(s, name, alts, token_defs, "        ");
  let s = s + "        lhs\n";
  let s = s + "    }\n\n";
  let s = s + "    fn " + fn_name + "_atom(&mut self) -> SyntaxNode {\n";
  let s = emit_pratt_atom_dispatch(s, name, atom_names, alts, token_defs, "        ");
  let s = s + "    }\n\n";
  emit_pratt_at_predicates(s, alts, token_defs)
}

fn emit_pratt_at_predicates(s: String, alts: List[PrattAlt], token_defs: List[String]): String =
  emit_pratt_at_predicates_dedup(s, alts, token_defs, List.nil)

fn emit_pratt_at_predicates_dedup(s: String, alts: List[PrattAlt], token_defs: List[String], seen: List[String]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        if list_contains_string(seen, name) {
          emit_pratt_at_predicates_dedup(s, rest, token_defs, seen)
        } else {
          let pred_name = "at_pratt_" + to_snake(name);
          let cond = make_first_elem_lookahead(elems, token_defs);
          let s2 = s + "    fn " + pred_name + "(&self) -> bool { " + cond + " }\n";
          emit_pratt_at_predicates_dedup(s2, rest, token_defs, List.cons(name, seen))
        }
      }
  }

fn emit_pratt_loop(s: String, rule_name: String, alts: List[PrattAlt], token_defs: List[String], indent: String): String {
  let fn_name = "parse_" + to_snake(rule_name);
  let s = s + indent + "loop {\n";
  let s = emit_pratt_infix_alts(s, fn_name, alts, token_defs, indent + "    ");
  let s = s + indent + "    break;\n";
  s + indent + "}\n"
}

fn emit_pratt_infix_alts(s: String, fn_name: String, alts: List[PrattAlt], token_defs: List[String], indent: String): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        match bp { .mk(lbp, rbp) =>
          match lbp {
            .none => emit_pratt_infix_alts(s, fn_name, rest, token_defs, indent),
            .num(lbp_val) => {
              let kind = to_screaming_snake(name);
              let lbp_str = lbp_val.to_string();
              let sa = s + indent + "// " + name + " (lbp=" + lbp_str + ")\n";
              let sb = sa + indent + "if self.at_pratt_" + to_snake(name) + "() && " + lbp_str + " > min_bp {\n";
              let sc = sb + indent + "    let mut children = vec![SyntaxElement::Node(Box::new(lhs))];\n";
              let rbp_str = match rbp { .none => lbp_str, .num(v) => v.to_string() };
              let sd = emit_parse_elements_filter_pratt(sc, elems, token_defs, fn_name, rbp_str, indent + "    ");
              let se = sd + indent + "    lhs = node_from_children(SyntaxKind::" + kind + ", children);\n";
              let sf = se + indent + "    continue;\n";
              let sg = sf + indent + "}\n";
              emit_pratt_infix_alts(sg, fn_name, rest, token_defs, indent)
            }
          }
        }
      }
  }

fn emit_parse_elements_filter_pratt(s: String, elems: List[Element], token_defs: List[String], fn_name: String, rbp_str: String, indent: String): String =
  match elems {
    .nil => s,
    .cons(elem, rest) =>
      match elem {
        .node(ref) =>
          match ref { .mk(rname) =>
            if rname == "Expr" {
              let s2 = s + indent + "children.push(SyntaxElement::Node(Box::new(self." + fn_name + "_bp(" + rbp_str + "))));\n";
              emit_parse_elements_filter_pratt(s2, rest, token_defs, fn_name, rbp_str, indent)
            } else {
              let s2 = s + indent + "children.push(SyntaxElement::Node(Box::new(self.parse_" + to_snake(rname) + "())));\n";
              emit_parse_elements_filter_pratt(s2, rest, token_defs, fn_name, rbp_str, indent)
            }
          },
        .labeled(label, inner) => emit_parse_elements_filter_pratt(s, List.cons(inner, rest), token_defs, fn_name, rbp_str, indent),
        .token(t) => {
          let s2 = emit_parse_token_element(s, t, indent);
          emit_parse_elements_filter_pratt(s2, rest, token_defs, fn_name, rbp_str, indent)
        },
        .optional(inner) => emit_parse_elements_filter_pratt(s, List.cons(inner, rest), token_defs, fn_name, rbp_str, indent),
        .repeated(inner) => emit_parse_elements_filter_pratt(s, List.cons(inner, rest), token_defs, fn_name, rbp_str, indent),
        .group(gelems) => emit_parse_elements_filter_pratt(s, list_concat_elem(gelems, rest), token_defs, fn_name, rbp_str, indent)
      }
  }

fn emit_pratt_atom_dispatch(s: String, rule_name: String, atom_names: List[String], alts: List[PrattAlt], token_defs: List[String], indent: String): String {
  let s2 = emit_prefix_alts(s, rule_name, alts, token_defs, indent);
  let s2 = emit_atom_dispatch_alts(s2, atom_names, indent);
  let s2 = s2 + indent + "self.error_here(\"expected expression\");\n";
  s2 + indent + "node_from_children(SyntaxKind::ERROR, Vec::new())\n"
}

fn emit_prefix_alts(s: String, rule_name: String, alts: List[PrattAlt], token_defs: List[String], indent: String): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        match bp { .mk(lbp, rbp) =>
          match lbp {
            .num(_) => emit_prefix_alts(s, rule_name, rest, token_defs, indent),
            .none => {
              let kind = to_screaming_snake(name);
              let rbp_str = match rbp { .none => "0", .num(v) => v.to_string() };
              let fn_name = "parse_" + to_snake(rule_name);
              let sa = s + indent + "if self.at_pratt_" + to_snake(name) + "() {\n";
              let sb = sa + indent + "    let mut children = Vec::new();\n";
              let sc = emit_parse_elements_filter_pratt(sb, elems, token_defs, fn_name, rbp_str, indent + "    ");
              let sd = sc + indent + "    return node_from_children(SyntaxKind::" + kind + ", children);\n";
              let se = sd + indent + "}\n";
              emit_prefix_alts(se, rule_name, rest, token_defs, indent)
            }
          }
        }
      }
  }

fn emit_atom_dispatch_alts(s: String, atom_names: List[String], indent: String): String =
  match atom_names {
    .nil => s,
    .cons(name, rest) => {
      let cond = "self.can_parse_" + to_snake(name) + "()";
      let call = "return self.parse_" + to_snake(name) + "();";
      let s2 = s + indent + "if " + cond + " { " + call + " }\n";
      emit_atom_dispatch_alts(s2, rest, indent)
    }
  }

// Emit parse logic for a list of elements
fn emit_parse_elements(s: String, elems: List[Element], token_defs: List[String], indent: String): String =
  match elems {
    .nil => s,
    .cons(elem, rest) => {
      let s2 = emit_parse_element(s, elem, token_defs, indent);
      emit_parse_elements(s2, rest, token_defs, indent)
    }
  }

fn emit_parse_element(s: String, elem: Element, token_defs: List[String], indent: String): String =
  match elem {
    .token(t) => emit_parse_token_element(s, t, indent),
    .node(ref) =>
      match ref { .mk(name) =>
        if list_contains_string(token_defs, name) {
          s + indent + "self.skip_trivia_into(&mut children);\n" +
          indent + "if matches!(self.current().map(|t| &t.kind), Some(LexKind::" + to_named_lex(name) + ")) {\n" +
          indent + "    children.push(SyntaxElement::Token(self.bump().unwrap()));\n" +
          indent + "} else { self.error_here(\"expected " + name + "\"); }\n"
        } else {
          s + indent + "children.push(SyntaxElement::Node(Box::new(self.parse_" + to_snake(name) + "())));\n"
        }
      },
    .labeled(label, inner) => emit_parse_element(s, inner, token_defs, indent),
    .optional(inner) => emit_parse_optional(s, inner, token_defs, indent),
    .repeated(inner) => emit_parse_repeated(s, inner, token_defs, indent),
    .group(gelems) => emit_parse_elements(s, gelems, token_defs, indent)
  }

fn emit_parse_token_element(s: String, t: TokenRef, indent: String): String =
  match t {
    .keyword(kw) =>
      if is_lexer_keyword(kw) {
        s + indent + "self.expect_keyword(Keyword::" + keyword_variant_pascal(kw) + ", &mut children);\n"
      } else {
        s + indent + "self.skip_trivia_into(&mut children);\n" +
        indent + "if self.current().map(|t| matches!(t.kind, LexKind::Ident) && t.text.as_str() == \"" + kw + "\").unwrap_or(false) {\n" +
        indent + "    children.push(SyntaxElement::Token(self.bump().unwrap()));\n" +
        indent + "} else { self.error_here(\"expected '" + kw + "'\"); }\n"
      },
    .symbol(sym) =>
      s + indent + "self.expect_symbol(\"" + sym + "\", &mut children);\n",
    .named(name) =>
      s + indent + "self.skip_trivia_into(&mut children);\n" +
      indent + "if matches!(self.current().map(|t| &t.kind), Some(LexKind::" + to_named_lex(name) + ")) {\n" +
      indent + "    children.push(SyntaxElement::Token(self.bump().unwrap()));\n" +
      indent + "} else { self.error_here(\"expected " + name + "\"); }\n"
  }

fn emit_parse_optional(s: String, inner: Element, token_defs: List[String], indent: String): String {
  let cond = make_element_lookahead(inner, token_defs);
  let s2 = s + indent + "if " + cond + " {\n";
  let s2 = emit_parse_element(s2, inner, token_defs, indent + "    ");
  s2 + indent + "}\n"
}

fn emit_parse_repeated(s: String, inner: Element, token_defs: List[String], indent: String): String {
  let cond = make_element_lookahead(inner, token_defs);
  let s2 = s + indent + "while " + cond + " {\n";
  let s2 = emit_parse_element(s2, inner, token_defs, indent + "    ");
  s2 + indent + "}\n"
}

fn make_element_lookahead(elem: Element, token_defs: List[String]): String =
  match elem {
    .token(t) =>
      match t {
        .keyword(kw) =>
          if is_lexer_keyword(kw) { "self.at_non_trivia_keyword(Keyword::" + keyword_variant_pascal(kw) + ")" }
          else { "self.at_non_trivia_ident_text(\"" + kw + "\")" },
        .symbol(sym) => "self.at_non_trivia_symbol(\"" + sym + "\")",
        .named(name) => "self.at_non_trivia_ident()"
      },
    .node(ref) =>
      match ref { .mk(name) =>
        if list_contains_string(token_defs, name) { "self.at_non_trivia_ident()" }
        else { "self.can_parse_" + to_snake(name) + "()" }
      },
    .labeled(label, inner) => make_element_lookahead(inner, token_defs),
    .optional(inner) => make_element_lookahead(inner, token_defs),
    .repeated(inner) => make_element_lookahead(inner, token_defs),
    .group(gelems) => make_group_lookahead(gelems, token_defs)
  }

// Groups are sequences, so the lookahead is the first non-skippable element's check.
fn make_group_lookahead(elems: List[Element], token_defs: List[String]): String =
  make_first_elem_lookahead(elems, token_defs)

fn to_named_lex(name: String): String =
  if name == "Ident" { "Ident" }
  else if name == "StringLit" { "StringLit" }
  else if name == "NumberLit" { "NumberLit" }
  else { "Ident" }

fn is_lexer_keyword(kw: String): Bool =
  if kw == "data" { Bool.true }
  else if kw == "fn" { Bool.true }
  else if kw == "extern" { Bool.true }
  else if kw == "let" { Bool.true }
  else if kw == "in" { Bool.true }
  else if kw == "thunk" { Bool.true }
  else if kw == "force" { Bool.true }
  else if kw == "match" { Bool.true }
  else if kw == "cap" { Bool.true }
  else if kw == "handle" { Bool.true }
  else if kw == "bundle" { Bool.true }
  else if kw == "use" { Bool.true }
  else if kw == "impl" { Bool.true }
  else if kw == "if" { Bool.true }
  else if kw == "else" { Bool.true }
  else { Bool.false }

fn keyword_variant_pascal(kw: String): String =
  if kw == "data" { "Data" }
  else if kw == "fn" { "Fn" }
  else if kw == "extern" { "Extern" }
  else if kw == "let" { "Let" }
  else if kw == "in" { "In" }
  else if kw == "thunk" { "Thunk" }
  else if kw == "force" { "Force" }
  else if kw == "match" { "Match" }
  else if kw == "cap" { "Cap" }
  else if kw == "handle" { "Handle" }
  else if kw == "bundle" { "Bundle" }
  else if kw == "use" { "Use" }
  else if kw == "impl" { "Impl" }
  else if kw == "if" { "If" }
  else if kw == "else" { "Else" }
  else { kw }

fn to_snake(name: String): String =
  to_snake_loop(name, 0, "")

fn to_snake_loop(name: String, i: Number, acc: String): String =
  if i >= name.len() { acc } else {
    let c = name.char_at(i);
    let code = c.char_code_at(0);
    let is_upper = if code >= 65 { code <= 90 } else { Bool.false };
    if is_upper {
      if 0 < i {
        to_snake_loop(name, i + 1, acc + "_" + to_lower_char(c))
      } else { to_snake_loop(name, i + 1, acc + to_lower_char(c)) }
    } else { to_snake_loop(name, i + 1, acc + c) }
  }

fn to_lower_char(c: String): String {
  let code = c.char_code_at(0);
  if code >= 65 {
    if code <= 90 { StrOps.from_char_code(code + 32) } else { c }
  } else { c }
}

fn list_concat_elem(xs: List[Element], ys: List[Element]): List[Element] =
  match xs {
    .nil => ys,
    .cons(x, rest) => List.cons(x, list_concat_elem(rest, ys))
  }

// Token wrapper node
fn emit_token_wrapper_node(s: String, name: String): String {
  let kind = to_screaming_snake(name);
  let s = s + "pub struct " + name + "<'a>(pub(crate) &'a SyntaxNode);\n\n";
  let s = s + "impl<'a> AstNode<'a> for " + name + "<'a> {\n";
  let s = s + "    fn cast(node: &'a SyntaxNode) -> Option<Self> {\n";
  let s = s + "        (node.kind == SyntaxKind::" + kind + ").then(|| Self(node))\n";
  let s = s + "    }\n";
  let s = s + "    fn syntax(&self) -> &'a SyntaxNode { self.0 }\n";
  let s = s + "}\n\n";
  s
}
