use libcore.prelude.{String, Number, Bool};
use libstd.list.{List};

fn generate_parser(grammar: Grammar): String =
  match grammar { .mk(token_defs, attrs, rules) => {
    let s = "// Auto-generated by langue. Do not edit.\n";
    let s = s + "// Regenerate: scripts/gen_langue.sh\n\n";
    let s = s + "use lumo_lexer::{lex_lossless, Keyword, LosslessTokenKind as LexKind};\n";
    let s = s + "use lumo_span::Span;\n\n";
    let s = s + "use crate::syntax_kind::SyntaxKind;\n\n";
    let s = emit_parser_boilerplate(s);
    let s = emit_parser_impl(s, token_defs, rules);
    s
  }}

fn emit_parser_boilerplate(s: String): String {
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub struct ParseError {\n    pub span: Span,\n    pub message: String,\n}\n\n";
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub struct LosslessToken {\n    pub kind: SyntaxKind,\n    pub span: Span,\n    pub text: String,\n}\n\n";
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub enum SyntaxElement {\n    Node(Box<SyntaxNode>),\n    Token(LosslessToken),\n}\n\n";
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub struct SyntaxNode {\n    pub kind: SyntaxKind,\n    pub span: Span,\n    pub children: Vec<SyntaxElement>,\n}\n\n";
  let s = s + "#[derive(Debug, Clone, PartialEq, Eq)]\n";
  let s = s + "pub struct ParseOutput {\n    pub root: SyntaxNode,\n    pub errors: Vec<ParseError>,\n}\n\n";
  let s = s + "pub fn parse(source: &str) -> ParseOutput {\n";
  let s = s + "    let lexed = lex_lossless(source);\n";
  let s = s + "    let mut p = Parser { tokens: lexed.tokens, index: 0, errors: Vec::new() };\n";
  let s = s + "    let root = p.parse_file();\n";
  let s = s + "    ParseOutput { root, errors: p.errors }\n}\n\n";
  let s = s + "pub fn node_text(node: &SyntaxNode) -> String {\n";
  let s = s + "    let mut out = String::new();\n";
  let s = s + "    write_node_text(node, &mut out);\n";
  let s = s + "    out\n}\n\n";
  let s = s + "fn write_node_text(node: &SyntaxNode, out: &mut String) {\n";
  let s = s + "    for child in &node.children {\n";
  let s = s + "        match child {\n";
  let s = s + "            SyntaxElement::Node(n) => write_node_text(n, out),\n";
  let s = s + "            SyntaxElement::Token(t) => out.push_str(&t.text),\n";
  let s = s + "        }\n    }\n}\n\n";
  let s = s + "fn node_from_children(kind: SyntaxKind, children: Vec<SyntaxElement>) -> SyntaxNode {\n";
  let s = s + "    let span = children_span(&children);\n";
  let s = s + "    SyntaxNode { kind, span, children }\n}\n\n";
  let s = s + "fn children_span(children: &[SyntaxElement]) -> Span {\n";
  let s = s + "    let start = children.iter().find_map(|c| match c {\n";
  let s = s + "        SyntaxElement::Token(t) => Some(t.span.start),\n";
  let s = s + "        SyntaxElement::Node(n) => if n.children.is_empty() { None } else { Some(n.span.start) },\n";
  let s = s + "    }).unwrap_or(0);\n";
  let s = s + "    let end = children.iter().rev().find_map(|c| match c {\n";
  let s = s + "        SyntaxElement::Token(t) => Some(t.span.end),\n";
  let s = s + "        SyntaxElement::Node(n) => if n.children.is_empty() { None } else { Some(n.span.end) },\n";
  let s = s + "    }).unwrap_or(0);\n";
  let s = s + "    Span::new(start, end)\n}\n\n";
  let s = s + "fn lexer_token_to_lst(t: lumo_lexer::LosslessToken) -> LosslessToken {\n";
  let s = s + "    LosslessToken { kind: lexer_kind_to_syntax_kind(&t.kind, &t.text), span: t.span, text: t.text }\n}\n\n";
  emit_lexer_kind_map(s)
}

fn emit_lexer_kind_map(s: String): String {
  let s = s + "fn lexer_kind_to_syntax_kind(kind: &LexKind, text: &str) -> SyntaxKind {\n";
  let s = s + "    match kind {\n";
  let s = s + "        LexKind::Ident => SyntaxKind::IDENT,\n";
  let s = s + "        LexKind::StringLit => SyntaxKind::STRING_LIT,\n";
  let s = s + "        LexKind::NumberLit => SyntaxKind::NUMBER_LIT,\n";
  let s = s + "        LexKind::Whitespace => SyntaxKind::WHITESPACE,\n";
  let s = s + "        LexKind::Newline => SyntaxKind::NEWLINE,\n";
  let s = s + "        LexKind::Unknown => SyntaxKind::UNKNOWN,\n";
  let s = s + "        LexKind::Keyword(kw) => match kw {\n";
  let s = s + "            Keyword::Data => SyntaxKind::DATA_KW,\n";
  let s = s + "            Keyword::Fn => SyntaxKind::FN_KW,\n";
  let s = s + "            Keyword::Extern => SyntaxKind::EXTERN_KW,\n";
  let s = s + "            Keyword::Let => SyntaxKind::LET_KW,\n";
  let s = s + "            Keyword::In => SyntaxKind::IN_KW,\n";
  let s = s + "            Keyword::Thunk => SyntaxKind::THUNK_KW,\n";
  let s = s + "            Keyword::Force => SyntaxKind::FORCE_KW,\n";
  let s = s + "            Keyword::Match => SyntaxKind::MATCH_KW,\n";
  let s = s + "            Keyword::Cap => SyntaxKind::CAP_KW,\n";
  let s = s + "            Keyword::Handle => SyntaxKind::HANDLE_KW,\n";
  let s = s + "            Keyword::Bundle => SyntaxKind::BUNDLE_KW,\n";
  let s = s + "            Keyword::Use => SyntaxKind::USE_KW,\n";
  let s = s + "            Keyword::Impl => SyntaxKind::IMPL_KW,\n";
  let s = s + "            Keyword::If => SyntaxKind::IF_KW,\n";
  let s = s + "            Keyword::Else => SyntaxKind::ELSE_KW,\n";
  let s = s + "            _ => SyntaxKind::UNKNOWN,\n";
  let s = s + "        },\n";
  let s = s + "        LexKind::Symbol(_) => SyntaxKind::from_symbol(text).unwrap_or(SyntaxKind::UNKNOWN),\n";
  let s = s + "    }\n}\n\n";
  s
}

fn emit_parser_struct(s: String): String {
  let s = s + "struct Parser {\n";
  let s = s + "    tokens: Vec<lumo_lexer::LosslessToken>,\n";
  let s = s + "    index: usize,\n";
  let s = s + "    errors: Vec<ParseError>,\n";
  let s = s + "}\n\n";
  s
}

fn emit_parser_helpers(s: String): String {
  let s = s + "impl Parser {\n";
  let s = s + "    fn eof(&self) -> bool { self.index >= self.tokens.len() }\n";
  let s = s + "    fn current(&self) -> Option<&lumo_lexer::LosslessToken> { self.tokens.get(self.index) }\n";
  let s = s + "    fn bump(&mut self) -> Option<LosslessToken> {\n";
  let s = s + "        let token = self.tokens.get(self.index).cloned();\n";
  let s = s + "        if token.is_some() { self.index += 1; }\n";
  let s = s + "        token.map(lexer_token_to_lst)\n";
  let s = s + "    }\n";
  let s = s + "    fn is_trivia_lex(kind: &LexKind) -> bool {\n";
  let s = s + "        matches!(kind, LexKind::Whitespace | LexKind::Newline)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_trivia(&self) -> bool {\n";
  let s = s + "        self.current().map(|t| Self::is_trivia_lex(&t.kind)).unwrap_or(false)\n";
  let s = s + "    }\n";
  let s = s + "    fn skip_trivia_into(&mut self, children: &mut Vec<SyntaxElement>) {\n";
  let s = s + "        while self.at_trivia() { children.push(SyntaxElement::Token(self.bump().unwrap())); }\n";
  let s = s + "    }\n";
  let s = s + "    fn peek_non_trivia_token(&self, n: usize) -> Option<&lumo_lexer::LosslessToken> {\n";
  let s = s + "        let mut count = 0; let mut i = self.index;\n";
  let s = s + "        while i < self.tokens.len() {\n";
  let s = s + "            let tok = &self.tokens[i];\n";
  let s = s + "            if !Self::is_trivia_lex(&tok.kind) {\n";
  let s = s + "                if count == n { return Some(tok); }\n";
  let s = s + "                count += 1;\n";
  let s = s + "            }\n";
  let s = s + "            i += 1;\n";
  let s = s + "        }\n";
  let s = s + "        None\n";
  let s = s + "    }\n";
  let s = s + "    fn at_keyword(&self, kw: Keyword) -> bool {\n";
  let s = s + "        matches!(self.current().map(|t| &t.kind), Some(LexKind::Keyword(actual)) if *actual == kw)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_keyword(&self, kw: Keyword) -> bool {\n";
  let s = s + "        matches!(self.peek_non_trivia_token(0).map(|t| &t.kind), Some(LexKind::Keyword(actual)) if *actual == kw)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_symbol(&self, text: &str) -> bool {\n";
  let s = s + "        self.peek_non_trivia_token(0).map(|t| t.text.as_str()) == Some(text)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_ident(&self) -> bool {\n";
  let s = s + "        matches!(self.peek_non_trivia_token(0).map(|t| &t.kind), Some(LexKind::Ident))\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_string_lit(&self) -> bool {\n";
  let s = s + "        matches!(self.peek_non_trivia_token(0).map(|t| &t.kind), Some(LexKind::StringLit))\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_number_lit(&self) -> bool {\n";
  let s = s + "        matches!(self.peek_non_trivia_token(0).map(|t| &t.kind), Some(LexKind::NumberLit))\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_name(&self) -> bool {\n";
  let s = s + "        matches!(self.peek_non_trivia_token(0).map(|t| &t.kind), Some(LexKind::Ident) | Some(LexKind::Keyword(_)))\n";
  let s = s + "    }\n";
  let s = s + "    fn expect_name(&mut self, children: &mut Vec<SyntaxElement>) {\n";
  let s = s + "        self.skip_trivia_into(children);\n";
  let s = s + "        if self.at_non_trivia_name() { children.push(SyntaxElement::Token(self.bump().unwrap())); }\n";
  let s = s + "        else { self.error_here(\"expected identifier\"); }\n";
  let s = s + "    }\n";
  let s = s + "    fn at_non_trivia_ident_text(&self, text: &str) -> bool {\n";
  let s = s + "        matches!(self.peek_non_trivia_token(0), Some(tok) if matches!(tok.kind, LexKind::Ident) && tok.text == text)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_ident(&self) -> bool {\n";
  let s = s + "        matches!(self.current().map(|t| &t.kind), Some(LexKind::Ident))\n";
  let s = s + "    }\n";
  let s = s + "    fn at_symbol_text(&self, text: &str) -> bool {\n";
  let s = s + "        self.current().map(|t| t.text.as_str()) == Some(text)\n";
  let s = s + "    }\n";
  let s = s + "    fn at_trivia_or_unknown(&self) -> bool {\n";
  let s = s + "        self.current().map(|t| matches!(t.kind, LexKind::Whitespace | LexKind::Newline | LexKind::Unknown)).unwrap_or(false)\n";
  let s = s + "    }\n";
  let s = s + "    fn error_here(&mut self, message: &str) {\n";
  let s = s + "        let span = self.current().map(|t| t.span).unwrap_or(Span::new(0, 0));\n";
  let s = s + "        self.errors.push(ParseError { span, message: message.to_owned() });\n";
  let s = s + "    }\n";
  let s = s + "    fn expect_keyword(&mut self, kw: Keyword, children: &mut Vec<SyntaxElement>) {\n";
  let s = s + "        self.skip_trivia_into(children);\n";
  let s = s + "        if self.at_keyword(kw) { children.push(SyntaxElement::Token(self.bump().unwrap())); }\n";
  let s = s + "        else { self.error_here(\"expected keyword\"); }\n";
  let s = s + "    }\n";
  let s = s + "    fn expect_symbol(&mut self, sym: &str, children: &mut Vec<SyntaxElement>) {\n";
  let s = s + "        self.skip_trivia_into(children);\n";
  let s = s + "        if self.at_symbol_text(sym) { children.push(SyntaxElement::Token(self.bump().unwrap())); }\n";
  let s = s + "        else { self.error_here(&format!(\"expected '{}'\", sym)); }\n";
  let s = s + "    }\n";
  let s = s + "    fn expect_ident(&mut self, children: &mut Vec<SyntaxElement>) {\n";
  let s = s + "        self.skip_trivia_into(children);\n";
  let s = s + "        if self.at_ident() { children.push(SyntaxElement::Token(self.bump().unwrap())); }\n";
  let s = s + "        else { self.error_here(\"expected identifier\"); }\n";
  let s = s + "    }\n";
  s + "}\n\n"
}

fn emit_parser_impl(s: String, token_defs: List[String], rules: List[Rule]): String {
  let s = emit_parser_struct(s);
  let s = emit_parser_helpers(s);
  let s = s + "impl Parser {\n";
  let s = emit_parse_rules(s, token_defs, rules);
  s + "}\n"
}

fn emit_parse_rules(s: String, token_defs: List[String], rules: List[Rule]): String =
  match rules {
    .nil => s,
    .cons(rule, rest) =>
      match rule { .mk(name, body) => {
        let s2 = emit_can_parse_method(s, name, body, token_defs);
        let s3 = emit_parse_rule(s2, name, body, token_defs);
        emit_parse_rules(s3, token_defs, rest)
      }}
  }

fn emit_can_parse_method(s: String, name: String, body: RuleBody, token_defs: List[String]): String {
  let fn_name = "can_parse_" + to_snake(name);
  let cond = make_body_lookahead(body, token_defs);
  s + "    fn " + fn_name + "(&self) -> bool { " + cond + " }\n"
}

fn make_body_lookahead(body: RuleBody, token_defs: List[String]): String =
  match body {
    .sequence(elems) => make_first_elem_lookahead(elems, token_defs),
    .alternatives(alts) => make_alts_lookahead(alts),
    .pratt(atom_names, alts) => make_pratt_lookahead(atom_names, alts)
  }

fn make_first_elem_lookahead(elems: List[Element], token_defs: List[String]): String =
  match elems {
    .nil => "false",
    .cons(elem, rest) => {
      let core = unwrap_labeled_elem(elem);
      match core {
        .optional(inner) => make_first_elem_lookahead(rest, token_defs),
        .repeated(inner) => {
          let suffix = make_first_elem_lookahead(rest, token_defs);
          let attr_prefix = make_attr_star_prefix(inner);
          if attr_prefix == "" { suffix }
          else if suffix == "false" { attr_prefix }
          else { attr_prefix + " || " + suffix }
        },
        _ => make_element_lookahead(elem, token_defs)
      }
    }
  }

fn make_attr_star_prefix(inner: Element): String =
  match inner {
    .node(ref) => match ref { .mk(name) =>
      if name == "Attribute" { "self.at_non_trivia_symbol(\"#\")" }
      else { "" }
    },
    _ => ""
  }

fn unwrap_labeled_elem(elem: Element): Element =
  match elem {
    .labeled(label, inner) => inner,
    _ => elem
  }

fn make_alts_lookahead(alts: List[Alternative]): String =
  match alts {
    .nil => "false",
    .cons(alt, rest) =>
      match alt { .mk(alt_name) => {
        let cond = "self.can_parse_" + to_snake(alt_name) + "()";
        match rest {
          .nil => cond,
          _ => cond + " || " + make_alts_lookahead(rest)
        }
      }}
  }

fn make_pratt_lookahead(atom_names: List[String], alts: List[PrattAlt]): String {
  let prefix_cond = make_prefix_alts_lookahead(alts);
  let atom_cond = make_atoms_lookahead(atom_names);
  if prefix_cond == "" { atom_cond }
  else if atom_cond == "false" { prefix_cond }
  else { prefix_cond + " || " + atom_cond }
}

fn make_prefix_alts_lookahead(alts: List[PrattAlt]): String =
  match alts {
    .nil => "",
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        match bp { .mk(lbp, rbp) =>
          match lbp {
            .num(_) => make_prefix_alts_lookahead(rest),
            .none => {
              let cond = "self.at_pratt_" + to_snake(name) + "()";
              let rest_cond = make_prefix_alts_lookahead(rest);
              if rest_cond == "" { cond }
              else { cond + " || " + rest_cond }
            }
          }
        }
      }
  }

fn make_atoms_lookahead(atom_names: List[String]): String =
  match atom_names {
    .nil => "false",
    .cons(name, rest) => {
      let cond = "self.can_parse_" + to_snake(name) + "()";
      match rest {
        .nil => cond,
        _ => cond + " || " + make_atoms_lookahead(rest)
      }
    }
  }

fn emit_parse_rule(s: String, name: String, body: RuleBody, token_defs: List[String]): String =
  match body {
    .sequence(elems) => emit_parse_sequence_rule(s, name, elems, token_defs),
    .alternatives(alts) =>
      if is_token_only_alternatives(alts) { s }
      else { emit_parse_alt_rule(s, name, alts) },
    .pratt(atom_names, alts) => emit_parse_pratt_rule(s, name, atom_names, alts, token_defs)
  }

fn emit_parse_sequence_rule(s: String, name: String, elems: List[Element], token_defs: List[String]): String =
  if name == "File" { emit_parse_file_with_recovery(s) }
  else {
    let fn_name = "parse_" + to_snake(name);
    let kind = to_screaming_snake(name);
    let s = s + "    fn " + fn_name + "(&mut self) -> SyntaxNode {\n";
    let s = s + "        let mut children = Vec::new();\n";
    let s = emit_parse_elements(s, elems, token_defs, "        ");
    let s = s + "        node_from_children(SyntaxKind::" + kind + ", children)\n";
    s + "    }\n\n"
  }

// Entry rule: consumes ALL tokens via error recovery so the lossless tree is always complete.
fn emit_parse_file_with_recovery(s: String): String {
  let s = s + "    fn parse_file(&mut self) -> SyntaxNode {\n";
  let s = s + "        let mut children = Vec::new();\n";
  let s = s + "        while !self.eof() {\n";
  let s = s + "            self.skip_trivia_into(&mut children);\n";
  let s = s + "            if self.eof() { break; }\n";
  let s = s + "            if self.can_parse_item() {\n";
  let s = s + "                children.push(SyntaxElement::Node(Box::new(self.parse_item())));\n";
  let s = s + "            } else {\n";
  let s = s + "                children.push(SyntaxElement::Node(Box::new(\n";
  let s = s + "                    node_from_children(SyntaxKind::ERROR, vec![SyntaxElement::Token(self.bump().unwrap())])\n";
  let s = s + "                )));\n";
  let s = s + "            }\n";
  let s = s + "        }\n";
  s + "        node_from_children(SyntaxKind::FILE, children)\n    }\n\n"
}

fn emit_parse_alt_rule(s: String, name: String, alts: List[Alternative]): String {
  let fn_name = "parse_" + to_snake(name);
  let s = s + "    fn " + fn_name + "(&mut self) -> SyntaxNode {\n";
  let s = emit_alt_dispatch(s, alts, "        ");
  let s = s + "        self.error_here(\"expected " + name + "\");\n";
  let s = s + "        node_from_children(SyntaxKind::ERROR, Vec::new())\n";
  s + "    }\n\n"
}

fn emit_alt_dispatch(s: String, alts: List[Alternative], indent: String): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(alt_name) => {
        let cond = make_alt_lookahead(alt_name);
        let call = "self.parse_" + to_snake(alt_name) + "()";
        let s2 = s + indent + "if " + cond + " { return " + call + "; }\n";
        emit_alt_dispatch(s2, rest, indent)
      }}
  }

fn make_alt_lookahead(name: String): String =
  "self.can_parse_" + to_snake(name) + "()"

fn emit_parse_pratt_rule(s: String, name: String, atom_names: List[String], alts: List[PrattAlt], token_defs: List[String]): String {
  let fn_name = "parse_" + to_snake(name);
  let s = s + "    fn " + fn_name + "(&mut self) -> SyntaxNode {\n";
  let s = s + "        self." + fn_name + "_bp(0)\n";
  let s = s + "    }\n\n";
  let s = s + "    fn " + fn_name + "_bp(&mut self, min_bp: u8) -> SyntaxNode {\n";
  let s = s + "        let mut lhs = self." + fn_name + "_atom();\n";
  let s = emit_pratt_loop(s, name, alts, token_defs, "        ");
  let s = s + "        lhs\n";
  let s = s + "    }\n\n";
  let s = s + "    fn " + fn_name + "_atom(&mut self) -> SyntaxNode {\n";
  let s = emit_pratt_atom_dispatch(s, name, atom_names, alts, token_defs, "        ");
  let s = s + "    }\n\n";
  emit_pratt_at_predicates(s, alts, token_defs)
}

fn emit_pratt_at_predicates(s: String, alts: List[PrattAlt], token_defs: List[String]): String =
  emit_pratt_at_predicates_dedup(s, alts, token_defs, List.nil)

fn emit_pratt_at_predicates_dedup(s: String, alts: List[PrattAlt], token_defs: List[String], seen: List[String]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        if list_contains_string(seen, name) {
          emit_pratt_at_predicates_dedup(s, rest, token_defs, seen)
        } else {
          let pred_name = "at_pratt_" + to_snake(name);
          let cond = make_first_elem_lookahead(elems, token_defs);
          let s2 = s + "    fn " + pred_name + "(&self) -> bool { " + cond + " }\n";
          emit_pratt_at_predicates_dedup(s2, rest, token_defs, List.cons(name, seen))
        }
      }
  }

fn emit_pratt_loop(s: String, rule_name: String, alts: List[PrattAlt], token_defs: List[String], indent: String): String {
  let fn_name = "parse_" + to_snake(rule_name);
  let s = s + indent + "loop {\n";
  let s = emit_pratt_infix_alts(s, fn_name, alts, token_defs, indent + "    ");
  let s = s + indent + "    break;\n";
  s + indent + "}\n"
}

fn emit_pratt_infix_alts(s: String, fn_name: String, alts: List[PrattAlt], token_defs: List[String], indent: String): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        match bp { .mk(lbp, rbp) =>
          match lbp {
            .none => emit_pratt_infix_alts(s, fn_name, rest, token_defs, indent),
            .num(lbp_val) => {
              let kind = to_screaming_snake(name);
              let lbp_str = lbp_val.to_string();
              let sa = s + indent + "// " + name + " (lbp=" + lbp_str + ")\n";
              let sb = sa + indent + "if self.at_pratt_" + to_snake(name) + "() && " + lbp_str + " > min_bp {\n";
              let sc = sb + indent + "    let mut children = vec![SyntaxElement::Node(Box::new(lhs))];\n";
              let rbp_str = match rbp { .none => lbp_str, .num(v) => v.to_string() };
              let sd = emit_parse_elements_filter_pratt(sc, elems, token_defs, fn_name, rbp_str, indent + "    ");
              let se = sd + indent + "    lhs = node_from_children(SyntaxKind::" + kind + ", children);\n";
              let sf = se + indent + "    continue;\n";
              let sg = sf + indent + "}\n";
              emit_pratt_infix_alts(sg, fn_name, rest, token_defs, indent)
            }
          }
        }
      }
  }

fn emit_parse_elements_filter_pratt(s: String, elems: List[Element], token_defs: List[String], fn_name: String, rbp_str: String, indent: String): String =
  match elems {
    .nil => s,
    .cons(elem, rest) =>
      match elem {
        .node(ref) =>
          match ref { .mk(rname) =>
            if rname == "Expr" {
              let s2 = s + indent + "children.push(SyntaxElement::Node(Box::new(self." + fn_name + "_bp(" + rbp_str + "))));\n";
              emit_parse_elements_filter_pratt(s2, rest, token_defs, fn_name, rbp_str, indent)
            } else {
              let s2 = s + indent + "children.push(SyntaxElement::Node(Box::new(self.parse_" + to_snake(rname) + "())));\n";
              emit_parse_elements_filter_pratt(s2, rest, token_defs, fn_name, rbp_str, indent)
            }
          },
        .labeled(label, inner) => emit_parse_elements_filter_pratt(s, List.cons(inner, rest), token_defs, fn_name, rbp_str, indent),
        .token(t) => {
          let s2 = emit_parse_token_element(s, t, indent);
          emit_parse_elements_filter_pratt(s2, rest, token_defs, fn_name, rbp_str, indent)
        },
        .optional(inner) => emit_parse_elements_filter_pratt(s, List.cons(inner, rest), token_defs, fn_name, rbp_str, indent),
        .repeated(inner) => emit_parse_elements_filter_pratt(s, List.cons(inner, rest), token_defs, fn_name, rbp_str, indent),
        .group(gelems) => emit_parse_elements_filter_pratt(s, list_concat_elem(gelems, rest), token_defs, fn_name, rbp_str, indent)
      }
  }

fn emit_pratt_atom_dispatch(s: String, rule_name: String, atom_names: List[String], alts: List[PrattAlt], token_defs: List[String], indent: String): String {
  let s2 = emit_prefix_alts(s, rule_name, alts, token_defs, indent);
  let s2 = emit_atom_dispatch_alts(s2, atom_names, indent);
  let s2 = s2 + indent + "self.error_here(\"expected expression\");\n";
  s2 + indent + "node_from_children(SyntaxKind::ERROR, Vec::new())\n"
}

fn emit_prefix_alts(s: String, rule_name: String, alts: List[PrattAlt], token_defs: List[String], indent: String): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        match bp { .mk(lbp, rbp) =>
          match lbp {
            .num(_) => emit_prefix_alts(s, rule_name, rest, token_defs, indent),
            .none => {
              let kind = to_screaming_snake(name);
              let rbp_str = match rbp { .none => "0", .num(v) => v.to_string() };
              let fn_name = "parse_" + to_snake(rule_name);
              let sa = s + indent + "if self.at_pratt_" + to_snake(name) + "() {\n";
              let sb = sa + indent + "    let mut children = Vec::new();\n";
              let sc = emit_parse_elements_filter_pratt(sb, elems, token_defs, fn_name, rbp_str, indent + "    ");
              let sd = sc + indent + "    return node_from_children(SyntaxKind::" + kind + ", children);\n";
              let se = sd + indent + "}\n";
              emit_prefix_alts(se, rule_name, rest, token_defs, indent)
            }
          }
        }
      }
  }

fn emit_atom_dispatch_alts(s: String, atom_names: List[String], indent: String): String =
  match atom_names {
    .nil => s,
    .cons(name, rest) => {
      let cond = "self.can_parse_" + to_snake(name) + "()";
      let call = "return self.parse_" + to_snake(name) + "();";
      let s2 = s + indent + "if " + cond + " { " + call + " }\n";
      emit_atom_dispatch_alts(s2, rest, indent)
    }
  }

fn emit_parse_elements(s: String, elems: List[Element], token_defs: List[String], indent: String): String =
  match elems {
    .nil => s,
    .cons(elem, rest) => {
      let s2 = emit_parse_element(s, elem, token_defs, indent);
      emit_parse_elements(s2, rest, token_defs, indent)
    }
  }

fn emit_parse_element(s: String, elem: Element, token_defs: List[String], indent: String): String =
  match elem {
    .token(t) => emit_parse_token_element(s, t, indent),
    .node(ref) =>
      match ref { .mk(name) =>
        if name == "AttrName" {
          s + indent + "self.expect_name(&mut children);\n"
        } else if list_contains_string(token_defs, name) {
          s + indent + "self.skip_trivia_into(&mut children);\n" +
          indent + "if matches!(self.current().map(|t| &t.kind), Some(LexKind::" + to_named_lex(name) + ")) {\n" +
          indent + "    children.push(SyntaxElement::Token(self.bump().unwrap()));\n" +
          indent + "} else { self.error_here(\"expected " + name + "\"); }\n"
        } else {
          s + indent + "children.push(SyntaxElement::Node(Box::new(self.parse_" + to_snake(name) + "())));\n"
        }
      },
    .labeled(label, inner) => emit_parse_element(s, inner, token_defs, indent),
    .optional(inner) => emit_parse_optional(s, inner, token_defs, indent),
    .repeated(inner) => emit_parse_repeated(s, inner, token_defs, indent),
    .group(gelems) => emit_parse_elements(s, gelems, token_defs, indent)
  }

fn emit_parse_token_element(s: String, t: TokenRef, indent: String): String =
  match t {
    .keyword(kw) =>
      if is_lexer_keyword(kw) {
        s + indent + "self.expect_keyword(Keyword::" + keyword_variant_pascal(kw) + ", &mut children);\n"
      } else {
        s + indent + "self.skip_trivia_into(&mut children);\n" +
        indent + "if self.current().map(|t| matches!(t.kind, LexKind::Ident) && t.text.as_str() == \"" + kw + "\").unwrap_or(false) {\n" +
        indent + "    children.push(SyntaxElement::Token(self.bump().unwrap()));\n" +
        indent + "} else { self.error_here(\"expected '" + kw + "'\"); }\n"
      },
    .symbol(sym) =>
      s + indent + "self.expect_symbol(\"" + sym + "\", &mut children);\n",
    .named(name) =>
      if name == "AttrName" {
        s + indent + "self.expect_name(&mut children);\n"
      } else {
        s + indent + "self.skip_trivia_into(&mut children);\n" +
        indent + "if matches!(self.current().map(|t| &t.kind), Some(LexKind::" + to_named_lex(name) + ")) {\n" +
        indent + "    children.push(SyntaxElement::Token(self.bump().unwrap()));\n" +
        indent + "} else { self.error_here(\"expected " + name + "\"); }\n"
      }
  }

fn emit_parse_optional(s: String, inner: Element, token_defs: List[String], indent: String): String {
  let cond = make_element_lookahead(inner, token_defs);
  let s2 = s + indent + "if " + cond + " {\n";
  let s2 = emit_parse_element(s2, inner, token_defs, indent + "    ");
  s2 + indent + "}\n"
}

fn emit_parse_repeated(s: String, inner: Element, token_defs: List[String], indent: String): String {
  let cond = make_element_lookahead(inner, token_defs);
  let s2 = s + indent + "while " + cond + " {\n";
  let s2 = emit_parse_element(s2, inner, token_defs, indent + "    ");
  s2 + indent + "}\n"
}

fn make_element_lookahead(elem: Element, token_defs: List[String]): String =
  match elem {
    .token(t) =>
      match t {
        .keyword(kw) =>
          if is_lexer_keyword(kw) { "self.at_non_trivia_keyword(Keyword::" + keyword_variant_pascal(kw) + ")" }
          else { "self.at_non_trivia_ident_text(\"" + kw + "\")" },
        .symbol(sym) => "self.at_non_trivia_symbol(\"" + sym + "\")",
        .named(name) =>
          if name == "AttrName" { "self.at_non_trivia_name()" }
          else if name == "StringLit" { "self.at_non_trivia_string_lit()" }
          else if name == "NumberLit" { "self.at_non_trivia_number_lit()" }
          else { "self.at_non_trivia_ident()" }
      },
    .node(ref) =>
      match ref { .mk(name) =>
        if name == "AttrName" { "self.at_non_trivia_name()" }
        else if list_contains_string(token_defs, name) { "self.at_non_trivia_ident()" }
        else { "self.can_parse_" + to_snake(name) + "()" }
      },
    .labeled(label, inner) => make_element_lookahead(inner, token_defs),
    .optional(inner) => make_element_lookahead(inner, token_defs),
    .repeated(inner) => make_element_lookahead(inner, token_defs),
    .group(gelems) => make_group_lookahead(gelems, token_defs)
  }

fn make_group_lookahead(elems: List[Element], token_defs: List[String]): String =
  make_first_elem_lookahead(elems, token_defs)

fn to_named_lex(name: String): String =
  if name == "Ident" { "Ident" }
  else if name == "StringLit" { "StringLit" }
  else if name == "NumberLit" { "NumberLit" }
  else { "Ident" }

fn is_lexer_keyword(kw: String): Bool =
  if kw == "data" { Bool.true }
  else if kw == "fn" { Bool.true }
  else if kw == "extern" { Bool.true }
  else if kw == "let" { Bool.true }
  else if kw == "in" { Bool.true }
  else if kw == "thunk" { Bool.true }
  else if kw == "force" { Bool.true }
  else if kw == "match" { Bool.true }
  else if kw == "cap" { Bool.true }
  else if kw == "handle" { Bool.true }
  else if kw == "bundle" { Bool.true }
  else if kw == "use" { Bool.true }
  else if kw == "impl" { Bool.true }
  else if kw == "if" { Bool.true }
  else if kw == "else" { Bool.true }
  else { Bool.false }

fn keyword_variant_pascal(kw: String): String =
  if kw == "data" { "Data" }
  else if kw == "fn" { "Fn" }
  else if kw == "extern" { "Extern" }
  else if kw == "let" { "Let" }
  else if kw == "in" { "In" }
  else if kw == "thunk" { "Thunk" }
  else if kw == "force" { "Force" }
  else if kw == "match" { "Match" }
  else if kw == "cap" { "Cap" }
  else if kw == "handle" { "Handle" }
  else if kw == "bundle" { "Bundle" }
  else if kw == "use" { "Use" }
  else if kw == "impl" { "Impl" }
  else if kw == "if" { "If" }
  else if kw == "else" { "Else" }
  else { kw }

fn list_concat_elem(xs: List[Element], ys: List[Element]): List[Element] =
  match xs {
    .nil => ys,
    .cons(x, rest) => List.cons(x, list_concat_elem(rest, ys))
  }
