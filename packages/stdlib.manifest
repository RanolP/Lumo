# The single-compilation-unit order for the ported stdlib (D-45).
# Paths are relative to packages/; decl order is binding order for the
# judge, so caps and impls precede their users (typeclass impls come
# after the backend bundles they delegate to, D-48).
libcore/src/prelude.lumo
libcore/src/cmp.lumo
libcore/src/ops.lumo
libcore/src/number.lumo
libcore/src/string.lumo
libcore/src#js/number.lumo
libcore/src#js/string.lumo
libcore/src#js/ops.lumo
libcore/src/number_impls.lumo
libcore/src/string_impls.lumo
libstd/src/io.lumo
libstd/src/fs.lumo
libstd/src/process.lumo
libstd/src/list.lumo
libstd/src#js/io.lumo
libstd/src#js.node/fs.lumo
libstd/src#js.node/process.lumo
hello/src/main.lumo
