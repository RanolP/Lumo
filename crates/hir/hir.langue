// HIR (High-level IR) grammar specification
// Desugared from Lumo surface: no binary/unary operators, no assignment sugar, no attributes.
// Operators are desugared to capability calls: `a + b` → `perform Add.add(a, b)`
// If/else is desugared to match. Produce/perform are explicit.
//
// To update: edit this file, then run `scripts/gen_langue.sh hir`
// Reference: crates/hir/src/lib.rs (Expr enum, Item enum)

#[parser(generate = true, path = "lossless.rs")]

@token Ident StringLit NumberLit

// === Top-level ===

File = items:Item*

Item =
  | ExternTypeDecl
  | ExternFnDecl
  | DataDecl
  | CapDecl
  | FnDecl
  | UseDecl
  | ImplDecl

// === Extern declarations ===

ExternTypeDecl = 'extern' 'type' name:Ident extern_as:ExternAs?
ExternFnDecl = inline:InlineHint? 'extern' 'fn' name:Ident param_list:ParamList return_ann:ReturnAnn? cap_annotation:CapAnnotation? extern_as:ExternAs?

ExternAs = 'as' value:StringLit
InlineHint = '#' '[' 'inline' '(' 'always' ')' ']'

// === Data types ===

DataDecl = 'data' name:Ident generic_params:GenericParams? '{' variants:VariantItems? '}'
VariantItems = Variant (',' Variant)* ','?
Variant = '.' name:Ident variant_fields:VariantFields?
VariantFields = '(' VariantFieldItems? ')'
VariantFieldItems = TypeExpr (',' TypeExpr)* ','?

// === Capabilities ===

CapDecl = 'cap' name:Ident '{' items:CapItem* '}'
CapItem =
  | AssocTypeDecl
  | OperationDecl
AssocTypeDecl = 'type' name:Ident
OperationDecl = 'fn' name:Ident param_list:ParamList return_ann:ReturnAnn?

// === Functions ===

FnDecl = 'fn' name:Ident generic_params:GenericParams? param_list:ParamList return_ann:ReturnAnn? cap_annotation:CapAnnotation? ':=' body:Expr

// === Use declarations ===

UseDecl = 'use' head:Ident rest:UseSegment* tree:UseTree? ';'
UseSegment = '.' seg:Ident
UseTree = '.' '{' names:UseTreeNames? '}'
UseTreeNames = Ident (',' Ident)* ','?

// === Impl blocks ===

ImplDecl = 'impl' generic_params:GenericParams? impl_name:ImplName? target:TypeExpr impl_cap:ImplCap? '{' items:ImplItem* '}'
ImplName = name:Ident '='
ImplCap = ':' cap:TypeExpr
ImplItem =
  | AssocTypeBinding
  | ImplMethod
AssocTypeBinding = 'type' name:Ident '=' ty:TypeExpr
ImplMethod = 'fn' name:Ident param_list:ParamList return_ann:ReturnAnn? ':=' body:Expr

// === Shared ===

GenericParams = '[' GenericParamItems? ']'
GenericParamItems = GenericParam (',' GenericParam)* ','?
GenericParam = ('cap')? name:Ident (':' BoundList)?
BoundList = Ident ('+' Ident)*

ParamList = '(' ParamItems? ')'
ParamItems = Param (',' Param)* ','?
Param = name:Ident ':' ty:TypeExpr
ReturnAnn = ':' ty:TypeExpr
CapAnnotation = '/' '{' CapItems? '}'
CapItems = TypeExpr (',' TypeExpr)* ','?

TypeExpr = name:Ident generic_args:GenericArgs?
GenericArgs = '[' GenericArgItems? ']'
GenericArgItems = TypeExpr (',' TypeExpr)* ','?

// === Expressions ===
// No BinaryExpr/UnaryExpr — those are desugared to capability calls at this level.
// No IfElse — desugared to match.
// Produce is explicit (implicit in surface syntax).

Expr =
  | IdentExpr
  | StringExpr
  | NumberExpr
  | LetExpr
  | ProduceExpr
  | ThunkExpr
  | ForceExpr
  | MatchExpr
  | CallExpr
  | MemberExpr
  | PerformExpr
  | HandleExpr
  | BundleExpr
  | AnnExpr
  | ErrorExpr

IdentExpr = name:Ident
StringExpr = value:StringLit
NumberExpr = value:NumberLit
LetExpr = 'let' name:Ident '=' value:Expr 'in' body:Expr
ProduceExpr = 'produce' value:Expr
ThunkExpr = 'thunk' body:Expr
ForceExpr = 'force' expr:Expr
MatchExpr = 'match' scrutinee:Expr '{' arms:MatchArm* '}'
MatchArm = pattern:Pattern '=>' body:Expr ';'?
CallExpr = callee:Expr '(' CallArgItems? ')'
CallArgItems = Expr (',' Expr)* ','?
MemberExpr = object:Expr '.' member:Ident
PerformExpr = 'perform' cap:Ident
HandleExpr = 'handle' cap:Ident type_args:GenericArgs? 'with' handler:Expr 'in' body:Expr
BundleExpr = 'bundle' '{' entries:BundleEntry* '}'
BundleEntry = 'fn' name:Ident param_list:ParamList ':=' body:Expr
AnnExpr = '(' expr:Expr ':' ty:TypeExpr ')'
ErrorExpr = '<' 'error' '>'

// === Patterns ===

Pattern =
  | VariantPattern
  | BindPattern
  | WildcardPattern

VariantPattern = '.' name:Ident ('(' PatternFieldItems? ')')?
PatternFieldItems = Pattern (',' Pattern)* ','?
BindPattern = name:Ident
WildcardPattern = '_'
