// Lumo surface syntax grammar
// Describes the shape of the lossless CST (concrete syntax tree).
// Used by langue to generate SyntaxKind enum + typed AST accessors.
//
// To update: edit this file, then run `scripts/gen_langue.sh compiler`
// Reference: crates/lst/src/parser.rs (Expr enum, Item enum)
//
// Comma-separated lists use wrapper nodes so accessors are generated:
//   FooList = '(' items:FooItems? ')'
//   FooItems = Foo (',' Foo)* ','?
// Items inside FooItems are unlabeled (langue limitation); walk lossless
// tree children of FooItems to get individual Foo nodes.

#[parser(generate = true, path = "lossless.rs")]

@token Ident StringLit NumberLit AttrName

// === Top-level ===

File = items:Item*

Item = attrs:Attribute* body:ItemBody

ItemBody =
  | ExternDecl
  | DataDecl
  | CapDecl
  | FnDecl
  | UseDecl
  | ImplDecl

// === Attributes ===

Attribute = '#' '[' name:AttrName ('=' direct_value:Expr)? AttributeArgs? ']'
AttributeArgs = '(' items:AttributeArgItem* ')'
AttributeArgItem = name:AttrName ('=' value:Expr)? ','?

// === Data types ===

DataDecl = 'data' name:Ident generic_params:GenericParams? '{' variants:Variant* '}'
Variant = attrs:Attribute* '.' name:Ident variant_fields:VariantFields? ','?
VariantFields = '(' fields:VariantFieldItems? ')'
VariantFieldItems = head:TypeExpr (',' tail:TypeExpr)* ','?

// === Functions ===

FnDecl = 'fn' name:Ident generic_params:GenericParams? param_list:ParamList (':' return_type:TypeExpr)? cap_annotation:CapAnnotation? body:FnBody

FnBody =
  | BlockExpr
  | ExprBody

ExprBody = '=' body:Expr

// === Generics ===

GenericParams = '[' params:GenericParamItems? ']'
GenericParamItems = head:GenericParam (',' tail:GenericParam)* ','?
GenericParam = name:Ident (':' constraint:BoundList)?
BoundList = head:TypeExpr ('+' tail:TypeExpr)*

// === Parameters ===

ParamList = '(' params:ParamItems? ')'
ParamItems = head:Param (',' tail:Param)* ','?
Param = name:Ident ':' ty:TypeExpr

// === Capabilities ===

CapAnnotation = '/' cap:CapSet
CapSet = '{' sigs:CapSig* '}'
CapSig = name:Ident generic_args:GenericArgs?
CapDecl = 'cap' name:Ident '{' operations:OperationDecl* '}'
OperationDecl = 'fn' name:Ident param_list:ParamList (':' return_type:TypeExpr)? ';'?

// === Extern declarations ===
//
// Standalone:
//   #[extern(name = "globalThis.console.log()")] extern fn println(msg: String);
//
// Grouped `extern { ... }` block — each inner decl inherits block attrs:
//   #[link(expr = "globalThis.String")]
//   extern {
//     #[extern(property = "length")] fn __str_len(s: String): Number;
//     #[extern(name = "charAt")] fn __str_char_at(s: String, i: Number): String;
//   }
//   #[link(module = "node:fs")]
//   extern {
//     fn readFileSync(path: String, encoding: String): String;
//   }
//
// Parser flattens blocks into individual ExternFnDecl / ExternTypeDecl items
// with the block's attrs merged into each. No distinct CST node.
ExternDecl = 'extern' rest:ExternRest
ExternRest =
  | ExternTypeTail
  | ExternFnTail
  | ExternBlockTail
ExternTypeTail = 'type' name:Ident ';'?
ExternFnTail = 'fn' name:Ident param_list:ParamList (':' return_type:TypeExpr)? cap_annotation:CapAnnotation? ';'?
ExternBlockTail = '{' items:ExternBlockItem* '}'
ExternBlockItem = attrs:Attribute* body:ExternBlockItemBody
ExternBlockItemBody =
  | ExternTypeTail
  | ExternFnTail

// === Use declarations ===

UseDecl = 'use' path:UsePath ';'
UsePath = head:Ident rest:UsePathRest?
UsePathRest = '.' item:UsePathItem
UsePathItem =
  | UsePathBranch
  | UseTree
UsePathBranch = next:Ident cont:UsePathRest?
UseTree = '{' names:UseNameItems? '}'
UseNameItems = head:UseNameItem (',' tail:UseNameItem)* ','?
UseNameItem = name:Ident

// === Impl blocks ===

ImplDecl = 'impl' generic_params:GenericParams? target:TypeExpr (':' cap:TypeExpr)? '{' methods:ImplMethod* '}'
ImplMethod = 'fn' name:Ident param_list:ParamList (':' return_type:TypeExpr)? body:FnBody

// === Expressions ===

Expr = pratt {
  atom: IdentExpr | StringExpr | NumberExpr | LetExpr | ThunkExpr | ForceExpr | MatchExpr | HandleExpr | BundleExpr | IfElseExpr | BlockExpr | ParenExpr | AnnotationExpr | LambdaExpr | PerformExpr

  UnaryExpr:  ('-' | '!') bp(50)
  MemberExpr: bp(90) '.' member:Ident
  CallExpr:   bp(90) '(' args:CallArgItems? ')'
  BinaryExpr: bp(30) ('*' | '/' | '%') bp(30)
  BinaryExpr: bp(20) ('+' | '-') bp(20)
  BinaryExpr: bp(10) ('==' | '!=' | '<' | '<=' | '>' | '>=') bp(10)
  BinaryExpr: bp(5)  '&&' bp(5)
  BinaryExpr: bp(3)  '||' bp(3)
  AssignExpr: bp(1)  '=' value:Expr ';' body:Expr
}

CallArgItems = head:Expr (',' tail:Expr)* ','?

IdentExpr = name:Ident
StringExpr = value:StringLit
NumberExpr = value:NumberLit

LetExpr = 'let' name:Ident (':' ty:TypeExpr)? '=' value:Expr
ThunkExpr = 'thunk' body:Expr
ForceExpr = 'force' expr:Expr
PerformExpr = 'perform' name:Ident

MatchExpr = 'match' scrutinee:Expr '{' arms:MatchArm* '}'
MatchArm = pattern:Pattern '=>' body:Expr ','?

HandleExpr = 'handle' cap_name:Ident ('for' cap_type:TypeExpr)? 'with' handler:Expr 'in' body:Expr
BundleExpr = 'bundle' '{' entries:BundleEntry* '}'
BundleEntry = 'fn' name:Ident param_list:ParamList body:FnBody ';'?

ParenExpr = '(' inner:Expr ')'
AnnotationExpr = '(' expr:Expr ':' ty:TypeExpr ')'
LambdaExpr = 'fn' param_list:LambdaParamList body:FnBody
LambdaParamList = '(' params:LambdaParamItems? ')'
LambdaParamItems = head:LambdaParam (',' tail:LambdaParam)* ','?
LambdaParam = name:Ident (':' ty:TypeExpr)?
BlockExpr = '{' stmts:BlockStmt* '}'

IfElseExpr = 'if' condition:Expr then_body:BlockExpr ('else' else_clause:ElseClause)?
ElseClause =
  | IfElseExpr
  | BlockExpr

BlockStmt =
  | LetStmt
  | ExprStmt
LetStmt = 'let' name:Ident '=' value:Expr ';'
ExprStmt = expr:Expr ';'?

// === Patterns ===

Pattern =
  | VariantPattern
  | BindPattern
  | WildcardPattern

VariantPattern = '.' name:Ident ('(' fields:VariantPatternFields? ')')?
VariantPatternFields = head:Pattern (',' tail:Pattern)* ','?
BindPattern = 'let' name:Ident
WildcardPattern = '_'

// === Types ===
// Types are kept simple in the CST. The typechecker does deeper parsing.

TypeExpr =
  | ThunkTypeExpr
  | FnTypeExpr
  | ProjTypeExpr
  | SimpleTypeExpr

ThunkTypeExpr = 'thunk' inner:TypeExpr
// FnTypeExpr: (T, U) -> R / { cap } — function type in value position
FnTypeExpr = '(' items:FnTypeParamItems? ')' '->' return_type:TypeExpr cap_annotation:CapAnnotation?
FnTypeParamItems = head:TypeExpr (',' tail:TypeExpr)* ','?
// ProjTypeExpr: Base.Assoc — associated type projection (postfix, head is a SimpleTypeExpr)
ProjTypeExpr = head:SimpleTypeExpr '.' assoc:Ident
SimpleTypeExpr = name:Ident generic_args:GenericArgs?
GenericArgs = '[' args:GenericArgItems? ']'
GenericArgItems = head:TypeExpr (',' tail:TypeExpr)* ','?
