use libcore.prelude.{String, Number, Bool};
use libstd.list.{List};

fn generate_syntax_kind(grammar: Grammar): String {
  let collected = collect_tokens(grammar);
  match collected { .mk(keywords, symbols) =>
  match grammar { .mk(token_defs, attrs, rules) => {
    let s = "// Auto-generated by langue. Do not edit.\n";
    let s = s + "// Regenerate: scripts/gen_langue.sh\n\n";
    let s = s + "#[allow(non_camel_case_types)]\n";
    let s = s + "#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n";
    let s = s + "#[repr(u16)]\n";
    let s = s + "pub enum SyntaxKind {\n";
    let s = s + "    // Named tokens\n";
    let s = emit_named_tokens(s, token_defs);
    let s = s + "    // Trivia\n";
    let s = s + "    WHITESPACE,\n    NEWLINE,\n    UNKNOWN,\n";
    let s = emit_keywords(s, keywords);
    let s = emit_symbols(s, symbols);
    let s = s + "    // Nodes\n";
    let s = emit_node_kinds(s, rules);
    let s = s + "    // Sentinel\n    ERROR,\n";
    let s = s + "}\n";
    let s = s + "\nimpl SyntaxKind {\n";
    let s = s + "    pub fn is_trivia(self) -> bool {\n";
    let s = s + "        matches!(self, Self::WHITESPACE | Self::NEWLINE)\n";
    let s = s + "    }\n";
    let s = emit_from_keyword(s, keywords);
    let s = emit_from_symbol(s, symbols);
    let s = s + "}\n";
    s
  }}}
}

fn emit_named_tokens(s: String, tokens: List[String]): String =
  match tokens {
    .nil => s,
    .cons(tok, rest) =>
      emit_named_tokens(s + "    " + to_screaming_snake(tok) + ",\n", rest)
  }

fn emit_keywords(s: String, kws: List[String]): String =
  match kws {
    .nil => s,
    _ => {
      let s2 = s + "    // Keywords\n";
      emit_keywords_items(s2, kws)
    }
  }

fn emit_keywords_items(s: String, kws: List[String]): String =
  match kws {
    .nil => s,
    .cons(kw, rest) => {
      let line = "    " + keyword_variant(kw) + ", // '" + kw + "'\n";
      emit_keywords_items(s + line, rest)
    }
  }

fn emit_symbols(s: String, syms: List[String]): String =
  match syms {
    .nil => s,
    .cons(sym, rest) => {
      let s2 = match rest { .nil => s, _ => match syms { _ => s + "    // Symbols\n" } };
      emit_symbols_items(s2, syms)
    }
  }

fn emit_symbols_items(s: String, syms: List[String]): String =
  match syms {
    .nil => s,
    .cons(sym, rest) => {
      let line = "    " + symbol_variant(sym) + ", // '" + sym + "'\n";
      emit_symbols_items(s + line, rest)
    }
  }

fn emit_node_kinds(s: String, rules: List[Rule]): String =
  match rules {
    .nil => s,
    .cons(rule, rest) =>
      match rule { .mk(name, body) =>
        match body {
          .sequence(elems) => {
            let line = "    " + to_screaming_snake(name) + ", // " + name + "\n";
            emit_node_kinds(s + line, rest)
          },
          .alternatives(alts) =>
            if is_token_only_alternatives(alts) {
              let line = "    " + to_screaming_snake(name) + ", // " + name + " (token wrapper)\n";
              emit_node_kinds(s + line, rest)
            } else {
              emit_node_kinds(s, rest)
            },
          .pratt(atom_names, alts) => {
            let s2 = emit_pratt_alt_kinds(s, alts);
            emit_node_kinds(s2, rest)
          }
        }
      }
  }

fn emit_pratt_alt_kinds(s: String, alts: List[PrattAlt]): String =
  emit_pratt_alt_kinds_dedup(s, alts, List.nil)

fn emit_pratt_alt_kinds_dedup(s: String, alts: List[PrattAlt], seen: List[String]): String =
  match alts {
    .nil => s,
    .cons(alt, rest) =>
      match alt { .mk(name, elems, bp) =>
        if list_contains_string(seen, name) {
          emit_pratt_alt_kinds_dedup(s, rest, seen)
        } else {
          let line = "    " + to_screaming_snake(name) + ", // " + name + "\n";
          emit_pratt_alt_kinds_dedup(s + line, rest, List.cons(name, seen))
        }
      }
  }

fn emit_from_keyword(s: String, kws: List[String]): String =
  match kws {
    .nil => s,
    _ => {
      let s = s + "\n    pub fn from_keyword(text: &str) -> Option<Self> {\n";
      let s = s + "        match text {\n";
      let s = emit_keyword_arms(s, kws);
      let s = s + "            _ => None,\n";
      let s = s + "        }\n";
      let s = s + "    }\n";
      s
    }
  }

fn emit_keyword_arms(s: String, kws: List[String]): String =
  match kws {
    .nil => s,
    .cons(kw, rest) => {
      let line = "            \"" + kw + "\" => Some(Self::" + keyword_variant(kw) + "),\n";
      emit_keyword_arms(s + line, rest)
    }
  }

fn emit_from_symbol(s: String, syms: List[String]): String =
  match syms {
    .nil => s,
    _ => {
      let s = s + "\n    pub fn from_symbol(text: &str) -> Option<Self> {\n";
      let s = s + "        match text {\n";
      let s = emit_symbol_arms(s, syms);
      let s = s + "            _ => None,\n";
      let s = s + "        }\n";
      let s = s + "    }\n";
      s
    }
  }

fn emit_symbol_arms(s: String, syms: List[String]): String =
  match syms {
    .nil => s,
    .cons(sym, rest) => {
      let line = "            \"" + sym + "\" => Some(Self::" + symbol_variant(sym) + "),\n";
      emit_symbol_arms(s + line, rest)
    }
  }
