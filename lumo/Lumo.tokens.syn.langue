// Lumo lexical structure (D-09): tokens are named literals/regexes only.
// Longest match wins; on ties a literal beats a regex (`fn` lexes as
// keyword.fn, not ident). Dotted names double as highlight scopes.
// Full legacy surface (migrated from legacy/crates/compiler/lumo.langue).

token keyword.fn      = 'fn'
token keyword.let     = 'let'
token keyword.in      = 'in'
token keyword.data    = 'data'
token keyword.cap     = 'cap'
token keyword.extern  = 'extern'
token keyword.use     = 'use'
token keyword.impl    = 'impl'
token keyword.match   = 'match'
token keyword.if      = 'if'
token keyword.else    = 'else'
token keyword.handle  = 'handle'
token keyword.with    = 'with'
token keyword.for     = 'for'
token keyword.thunk   = 'thunk'
token keyword.force   = 'force'
token keyword.bundle  = 'bundle'
token keyword.perform = 'perform'
token keyword.type    = 'type'

token ident      = /[a-zA-Z_][a-zA-Z0-9_]*/
token lit.number = /[0-9]+(\.[0-9]+)?/
token lit.string = /"([^"\\]|\\.)*"/

token paren.open    = '('
token paren.close   = ')'
token brace.open    = '{'
token brace.close   = '}'
token bracket.open  = '['
token bracket.close = ']'
token comma         = ','
token semi          = ';'
token colon         = ':'
token dot           = '.'
token dotdot        = '..'
token hash          = '#'
token underscore    = '_'
token arrow.fat     = '=>'
token arrow.thin    = '->'

token op.eq      = '='
token op.plus    = '+'
token op.minus   = '-'
token op.star    = '*'
token op.slash   = '/'
token op.percent = '%'
token op.pow     = '**'
token op.bang    = '!'
token op.eqeq    = '=='
token op.neq     = '!='
token op.lt      = '<'
token op.le      = '<='
token op.gt      = '>'
token op.ge      = '>='
token op.andand  = '&&'
token op.oror    = '||'

trivia whitespace   = /[ \t\r\n]+/
trivia comment.line = /\/\/[^\n]*/
