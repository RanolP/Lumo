// JS: the emission target (D-03, D-43) — a JavaScript *subset* just
// large enough to carry compiled MIR. Emission is pretty-printing this
// tree. LL(1) notes (D-43): `(…)` is always the n-ary ParenExpr (it
// doubles as an arrow parameter list) and `=>` is an ordinary
// right-associative infix operator, so `(x, y) => b`, `x => b` and
// `() => b` parse without JS's cover grammar; ternary is a postfix row
// carrying a `then ':' else` payload.

token keyword.const    = 'const'
token keyword.function = 'function'
token keyword.return   = 'return'

token ident      = /[a-zA-Z_$][a-zA-Z0-9_$]*/
token lit.number = /[0-9]+(\.[0-9]+)?/
token lit.string = /"([^"\\]|\\.)*"/

token paren.open    = '('
token paren.close   = ')'
token brace.open    = '{'
token brace.close   = '}'
token bracket.open  = '['
token bracket.close = ']'
token comma         = ','
token semi          = ';'
token colon         = ':'
token dot           = '.'
token question      = '?'
token arrow.fat     = '=>'
token op.eq3        = '==='
token op.assign     = '='

trivia whitespace   = /[ \t\r\n]+/
trivia comment.line = /\/\/[^\n]*/

File = stmts:ConstDecl*
ConstDecl = 'const' name:ident '=' value:Expr ';'

// === Expressions ===

IdentExpr = name:ident
NumExpr = value:lit.number
StrExpr = value:lit.string

// N-ary on purpose: `(a)` groups, `(a, b)` is an arrow parameter list,
// `()` is an empty one (D-43).
ParenExpr = '(' items:sep(Expr, ',')? ')'
ObjectExpr = '{' props:ObjectProp* '}'
ObjectProp = name:ident ':' value:Expr ','?
ArrayExpr = '[' items:sep(Expr, ',')? ']'
// Named function expression — the `fix` target: `f` scopes over the
// body, `f()` re-enters it (D-43).
FnExpr = 'function' name:ident '(' ')' '{' 'return' body:Expr ';' '}'

MemberName = name:ident
CallArgs = args:sep(Expr, ',')?
IndexArg = index:Expr
TernaryTail = then:Expr ':' alt:Expr

Expr = praat {
  simple = IdentExpr | NumExpr | StrExpr | ParenExpr | ObjectExpr | ArrayExpr | FnExpr
  operators {
    @110 '.' MemberName,
    @110 '(' CallArgs ')',
    @110 '[' IndexArg ']',
    @60 '===' @59,
    @30 '?' TernaryTail,
    @20 '=>' @21,
  }
}
