// Lumo → MIR elaboration (D-35). Reference semantics: the legacy
// HIR→LIR lowering (legacy/crates/lir/src/lib.rs). Sort mismatches are
// engine-coerced (D-38): a computation in value position auto-lets
// (`let __tN = c in …`), a value in computation position returns
// (`ret v`) — both implemented in `elab_externs.rs`.

// Extern rules (D-01/D-38) host what syntax-directed rules cannot:
//   module           — File assembly: skips type-level items, collects defs
//   fn_curry         — fn/lambda param lists fold into curried thunk spines;
//                      a fully annotated fn signature also becomes a
//                      def-level `(thunk {…} : U(…))` annotation — types
//                      curried to match the term, CapAnnotation → CapRow
//                      on the innermost F, GenericParams → forall (M2
//                      step 2; D-39/40/41)
//   paren_annot      — `(e : T)` keeps its annotation as ParenV when the
//                      type translates; plain parens stay transparent
//   block            — block statements fold into nested `let`
//   match_arm        — optional binder lists (no absent-field patterns)
//   member_classify  — data ctor vs cap op vs value method (needs decls)
//   use_decl         — `use` → require-derived defs (D-30)
extern rule module from Lumo to MIR
extern rule fn_curry from Lumo to MIR
extern rule paren_annot from Lumo to MIR
extern rule block from Lumo to MIR
extern rule match_arm from Lumo to MIR
extern rule member_classify from Lumo to MIR
extern rule use_decl from Lumo to MIR

// Extern passes (D-12/D-30): self-recursive defs get `fix`; require-
// derived defs are hoisted first.
extern pass scc_fix
extern pass use_require

from Lumo to MIR {
  NumberExpr { value: $v } ==> NumV { value: $v }
  StringExpr { value: $v } ==> StrV { value: $v }
  IdentExpr { name: $n } ==> VarV { name: $n }

  ThunkExpr { body: $b } ==> ThunkV { body: $b to MIR }
  ForceExpr { expr: $e } ==> ForceC { value: $e to MIR }
  PerformExpr { name: $c } ==> PerformC { cap: $c }

  // `= expr` fn bodies are transparent (parens live in paren_annot).
  ExprBody { body: $e } ==> $e to MIR

  // match auto-unrolls its scrutinee (legacy mk_unroll).
  MatchExpr { scrutinee: $s, arms: [$a*] }
    ==> CaseC { scrutinee: UnrollV { value: $s to MIR }, arms: [$a* to MIR] }

  HandleExpr { cap_name: $c, handler: $h, body: $b }
    ==> HandleC { cap: $c, handler: $h to MIR, body: $b to MIR }

  BundleExpr { entries: [$e*] } ==> BundleV { clauses: [$e* to MIR] }
  BundleEntry { name: $n, param_list: ParamList { params: [$p*] }, body: $b }
    ==> BundleClause { name: $n, params: [$p* to MIR], body: $b to MIR }
  Param { name: $n } ==> VarV { name: $n }

  // Patterns become case binders (spliced as plain idents).
  BindPattern { name: $n } ==> VarV { name: $n }
  IdentPattern { name: $n } ==> VarV { name: $n }
  WildcardPattern ==> VarV { name: '_' }

  // Calls force the callee and apply value args (legacy force-then-
  // apply). A computation callee/arg is coerced by the engine (D-38).
  ExprPostfix { expr: $f, call_args: CallArgs { args: [$a*] } }
    ==> CompPostfix { expr: ForceC { value: $f to MIR }, value_args: ValueArgs { args: [$a* to MIR] } }
}

// Same-language MIR relations (D-14): compiled to egglog and executed
// by the D-42 saturate/extract/reduce loop. U-beta cancels
// force-of-thunk; F-beta is the let-ret rule via the built-in subst
// tactic (D-24, reduced host-side). Parens are syntax. A handle whose
// body is exactly `perform` of the same cap returns the handler — the
// local core of legacy LTO's capability monomorphization (D-42).
between MIR {
  ForceC { value: ThunkV { body: $c } } === $c
  LetC { name: $b, value: RetC { value: $a }, body: $e } === $e[$b := $a]
  ParenC { inner: $c } === $c
  HandleC { cap: $c, handler: $h, body: PerformC { cap: $c } } === RetC { value: $h }
}
