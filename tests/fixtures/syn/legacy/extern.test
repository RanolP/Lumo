=== operators and lambdas (grammar coverage) ===
:parse(Lumo)

fn ops(a, b) = a % b == 0 && a <= b || !(a > b)
fn apply() { map(fn (x: Number) = x * 2, xs) }
fn typed(f: (Number, Number) -> Number / { Console }, x: thunk Item.Value) = f(x, x)
fn seq() { bundle { fn go() { done() }; } }

