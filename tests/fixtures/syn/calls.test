=== call with arguments ===
:parse(Lumo)

fn t() = add(1, 2)

---

(FILE (FN_DECL (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (NUMBER_EXPR) (NUMBER_EXPR)))))

=== curried call chains are postfix ===
:parse(Lumo)

fn t() = f(1)(2)(3)

---

(FILE (FN_DECL (EXPR_POSTFIX (EXPR_POSTFIX (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (NUMBER_EXPR))) (CALL_ARGS (NUMBER_EXPR))) (CALL_ARGS (NUMBER_EXPR)))))

=== call binds tighter than operators ===
:parse(Lumo)

fn t() = -f(x) + g(y) * 2

---

(FILE (FN_DECL (EXPR_INFIX (EXPR_PREFIX (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (IDENT_EXPR)))) (EXPR_INFIX (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (IDENT_EXPR))) (NUMBER_EXPR)))))

=== nested calls and lets (migrated from legacy syntax fixtures) ===
:parse(Lumo)

fn compose(f, g, x) = f(g(x))
fn main() = let r = compose(id, id, 42) in print(r)

---

(FILE (FN_DECL (PARAM) (PARAM) (PARAM) (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (IDENT_EXPR)))))) (FN_DECL (LET_EXPR (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (IDENT_EXPR) (IDENT_EXPR) (NUMBER_EXPR))) (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (IDENT_EXPR))))))

