=== empty file parses to a bare FILE ===
:parse(Lumo)



---

(FILE)

=== single fn without params ===
:parse(Lumo)

fn one() = 1

---

(FILE (ITEM (FN_DECL (PARAM_LIST) (EXPR_BODY (NUMBER_EXPR)))))

=== params with trailing comma ===
:parse(Lumo)

fn pair(a, b,) = a

---

(FILE (ITEM (FN_DECL (PARAM_LIST (PARAM) (PARAM)) (EXPR_BODY (IDENT_EXPR)))))

=== two decls with comments (migrated from legacy syntax fixtures) ===
:parse(Lumo)

// identity
fn id(x) = x
fn twice(f, x) = f(f(x))  // apply twice

---

(FILE (ITEM (FN_DECL (PARAM_LIST (PARAM)) (EXPR_BODY (IDENT_EXPR)))) (ITEM (FN_DECL (PARAM_LIST (PARAM) (PARAM)) (EXPR_BODY (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (EXPR_POSTFIX (IDENT_EXPR) (CALL_ARGS (IDENT_EXPR)))))))))

