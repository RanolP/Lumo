=== constructors make their data type ===
:infer(Lumo)

data OptionA { .some(A), .none }
fn mk(a: A): OptionA / {} { OptionA.some(a) }

---

mk : U((A) -> F(OptionA))

=== generic data instantiates from the expectation ===
:infer(Lumo)

data Nat { .zero, .succ(Nat) }
data Option[A] { .some(A), .none }
fn sub1(x: Nat): Option[Nat] / {} { match x { .zero => Option.none, .succ(let x) => Option.some(x) } }

---

sub1 : U((Nat) -> F(Option[Nat]))

=== match binder types flow ===
:infer(Lumo)

data OptionA { .some(A), .none }
fn pick2(a: OptionA, b: A): A / {} { match a { .some(let x) => x, .none => b } }

---

pick2 : U((OptionA) -> (A) -> F(A))

