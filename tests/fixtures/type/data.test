=== iso-recursive lists ===
:infer(Lumo)

data List[A] { .nil, .cons(A, List[A]) }
fn head_or(l: List[Number], d: Number): Number / {} { match l { .nil => d, .cons(x, xs) => x } }

---

head_or : U((List[Number]) -> (Number) -> F(Number))

=== tree with three binders ===
:infer(Lumo)

data Tree[A] { .leaf, .node(Tree[A], A, Tree[A]) }
fn depth(t: Tree[Number]): Number / {} { match t { .leaf => 0, .node(l, x, r) => x } }

---

depth : U((Tree[Number]) -> F(Number))

=== roll after unroll ===
:infer(Lumo)

data Nat { .zero, .succ(Nat) }
fn double(n: Nat): Nat / {} { match n { .zero => Nat.zero, .succ(let m) => Nat.succ(Nat.succ(m)) } }

---

double : U((Nat) -> F(Nat))

=== nested match in an arm body (D-46) ===
:infer(Lumo)

data Bool { .true, .false }
data Ordering { .less, .equal, .greater }
fn pick(a: Bool, b: Bool): Ordering / {} {
  match a {
    .true => Ordering.less,
    .false => match b {
      .true => Ordering.equal,
      .false => Ordering.greater,
    },
  }
}

---

pick : U((Bool) -> (Bool) -> F(Ordering))

=== nested match binds at both levels (D-46) ===
:infer(Lumo)

data Nat { .zero, .succ(Nat) }
fn two_deep(n: Nat): Nat / {} {
  match n {
    .zero => n,
    .succ(let m) => match m {
      .zero => m,
      .succ(let k) => k,
    },
  }
}

---

two_deep : U((Nat) -> F(Nat))
