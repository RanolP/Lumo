=== named handler in scope ===
:infer(Lumo)

cap E { fn op(): A }
fn f(h: E): A / {} { handle E with h in E.op }

---

f : U((E) -> F(A))

=== handled body may ignore the cap ===
:infer(Lumo)

cap E { fn op(): A }
fn f(h: E, a: A): A / {} { handle E with h in a }

---

f : U((E) -> (A) -> F(A))

=== a cap name is not a term ===
:infer(Lumo)

cap E { fn op(): A }
fn f(): A / {} { E }

---

ERROR

=== handler type mismatch ===
:infer(Lumo)

cap E { fn op(): A }
fn f(h: thunk B, a: A): A / {} { handle E with h in a }

---

ERROR

=== inline bundle handler ===
:infer(Lumo)

cap E { fn op(): A }
fn f(a: A): A / {} { handle E with bundle { fn op() { a } } in E.op }

---

f : U((A) -> F(A))

=== two caps nest ===
:infer(Lumo)

cap E1 { fn op1(): A }
cap E2 { fn op2(): B }
fn f(h1: E1, h2: E2): A / {} { handle E1 with h1 in handle E2 with h2 in E1.op1 }

---

f : U((E1) -> (E2) -> F(A))

=== typed op params check their arguments ===
:infer(Lumo)

cap Transform { fn apply(x: A): B }
fn f(a: A, b: B): B / {} { handle Transform with bundle { fn apply(x) { b } } in Transform.apply(a) }

---

f : U((A) -> (B) -> F(B))

=== multi-op bundle ===
:infer(Lumo)

cap E { fn op1(): A; fn op2(x: A): B }
fn f(a: A, b: B): A / {} { handle E with bundle { fn op1() { a }; fn op2(x) { b } } in E.op1 }

---

f : U((A) -> (B) -> F(A))

=== bundles must cover every op ===
:infer(Lumo)

cap E { fn op1(): A; fn op2(x: A): B }
fn f(a: A): A / {} { handle E with bundle { fn op1() { a } } in E.op1 }

---

ERROR

=== bundles may not invent ops ===
:infer(Lumo)

cap E { fn op(): A }
fn f(a: A): A / {} { handle E with bundle { fn op() { a }; fn bogus() { a } } in E.op }

---

ERROR

=== member access on a plain type ===
:infer(Lumo)

fn f(a: A): A / {} { let x = a.field; x }

---

ERROR

=== unknown operation ===
:infer(Lumo)

cap E { fn op(): A }
fn f(h: E): A / {} { handle E with h in E.bogus }

---

ERROR

=== capabilities thread through calls (D-51) ===
:infer(Lumo)

cap E { fn op(x: A): A }
fn inner(x: A): A / {E} { E.op(x) }
fn outer(x: A): A / {E} { inner(x) }
fn top(h: E, x: A): A / {} { handle E with h in outer(x) }

---

inner : U((E) -> (A) -> F(A))
outer : U((E) -> (A) -> F(A))
top : U((E) -> (A) -> F(A))
