=== generic impls: rigid binders in the body, fresh at each use (D-50) ===
:infer(Lumo)

extern type Number;
data List[A] { .nil, .cons(A, List[A]) }
impl[T] List[T] {
  fn map[R](self: List[T], mapper: (T) -> R): List[R] =
    match self {
      .nil => resume(List.nil),
      .cons(h, t) => resume(List.cons(mapper(h), t.map(mapper)))
    }
}
fn bump(xs: List[Number]): List[Number] / {} { xs.map(fn(n: Number) = n) }

