=== generic identity instantiates per use ===
:infer(Lumo)

data Nat { .zero }
fn id[T](x: T): T / {} { x }
fn use_it(n: Nat): Nat / {} { id(n) }

---

id : U(forall T. (T) -> F(T))
use_it : U((Nat) -> F(Nat))

=== if/else types both branches against one result (D-47) ===
:infer(Lumo)

data Bool { .true, .false }
fn choose(b: Bool): Number / {} { if b { 1 } else { 2 } }

---

choose : U((Bool) -> F(Number))

=== if/else branches must agree ===
