:elab(Lumo -> MIR)

fn spin(x) = spin(x)

---

def spin = thunk { fix spin => fn(x) => force spin(x) }

=== use decls become require defs, hoisted first (D-30) ===
:elab(Lumo -> MIR)

fn f(x) = g(x)
use foo.g;

---

def g = thunk { let m = force require("foo") in sel m.g }
def f = thunk { fn(x) => force g(x) }

