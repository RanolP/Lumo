def main = thunk { sel __impl_Console.log("hi") }

=== multi-method impls bundle every op (D-44) ===
:elab(Lumo -> MIR)

cap Pair {
  fn first(a, b)
  fn second(a, b)
}
impl Pair {
  fn first(a, b) = resume(a)
  fn second(a, b) = resume(b)
}
fn snd(x, y) = Pair.second(x, y)

---

def __impl_Pair = (bundle { fn first(a, b) => ret a fn second(a, b) => ret b } : Pair)
def snd = thunk { fn(x) => fn(y) => sel __impl_Pair.second(x, y) }

=== if/else desugars to a Bool match (D-47) ===
:elab(Lumo -> MIR)

data Bool { .true, .false }
fn choose(b) = if b { 1 } else { 2 }

---

def choose = thunk { fn(b) =>
  case unroll b {
    .true => ret 1
    .false => ret 2
  }
}

=== else-if chains recurse (D-47) ===
:elab(Lumo -> MIR)

data Bool { .true, .false }
fn pick(a, b) = if a { 1 } else if b { 2 } else { 3 }

---

def pick = thunk { fn(a) => fn(b) =>
  case unroll a {
    .true => ret 1
    .false => case unroll b {
      .true => ret 2
      .false => ret 3
    }
  }
}

=== typeclass impls become instance-cap bundle defs (D-48) ===
:elab(Lumo -> MIR)

extern type Number;
cap Add { fn add(a: Self, b: Self): Self }
extern fn __num_add(a: Number, b: Number): Number;
impl Number: Add { fn add(self, other: Self): Self = resume(__num_add(self, other)) }

---

def __impl_Add_Number = (bundle { fn add(self, other) => force __num_add(self, other) } : Add_Number)

=== operators dispatch on syntactic operand types (D-48) ===
:elab(Lumo -> MIR)

extern type Number;
cap Add { fn add(a: Self, b: Self): Self }
extern fn __num_add(a: Number, b: Number): Number;
impl Number: Add { fn add(self, other: Self): Self = resume(__num_add(self, other)) }
fn three() = 1 + 2
fn inc(x: Number) = x + 1

---

def __impl_Add_Number = (bundle { fn add(self, other) => force __num_add(self, other) } : Add_Number)
def three = thunk { sel __impl_Add_Number.add(1, 2) }
def inc = thunk { fn(x) => sel __impl_Add_Number.add(x, 1) }

=== boolean operators are lazy Bool cases (D-48) ===
:elab(Lumo -> MIR)

data Bool { .true, .false }
fn and(a: Bool, b: Bool) = a && b

---

def and = thunk { fn(a) => fn(b) =>
  case unroll a {
    .true => ret b
    .false => ret roll .false
  }
}

=== comparisons go through PartialOrd.cmp and an Ordering case (D-48) ===
:elab(Lumo -> MIR)

extern type Number;
data Bool { .true, .false }
data Ordering { .less, .equal, .greater }
cap PartialOrd { fn cmp(a: Self, b: Self): Ordering }
extern fn __num_lt(a: Number, b: Number): Bool;
impl Number: PartialOrd {
  fn cmp(self, other: Self): Ordering = match __num_lt(self, other) {
    .true => resume(Ordering.less),
    .false => resume(Ordering.greater),
  }
}
fn below(a: Number, b: Number) = a < b

---

def __impl_PartialOrd_Number = (bundle { fn cmp(self, other) =>
  let __t1 = force __num_lt(self, other) in
  case unroll __t1 {
    .true => ret roll .less
    .false => ret roll .greater
  }
} : PartialOrd_Number)
def below = thunk { fn(a) => fn(b) =>
  let __t2 = sel __impl_PartialOrd_Number.cmp(a, b) in
  case unroll __t2 {
    .less => ret roll .true
    .equal => ret roll .false
    .greater => ret roll .false
  }
}

=== inherent impls become instance-cap bundle defs (D-49) ===
:elab(Lumo -> MIR)

extern type String;
extern type Number;
extern fn __str_len(s: String): Number;
impl String {
  fn len(self): Number = resume(__str_len(self))
}

---

def __impl_String = (bundle { fn len(self) => force __str_len(self) } : String_impl)

=== value methods dispatch on the syntactic type (D-49) ===
:elab(Lumo -> MIR)

extern type String;
extern type Number;
extern fn __str_len(s: String): Number;
extern fn __str_concat(a: String, b: String): String;
impl String {
  fn len(self): Number = resume(__str_len(self))
  fn append(self, other: String): String = resume(__str_concat(self, other))
}
fn chain(s: String) = s.append("!").len()

---

def __impl_String = (bundle {
  fn len(self) => force __str_len(self)
  fn append(self, other) => force __str_concat(self, other)
} : String_impl)
def chain = thunk { fn(s) =>
  let __t1 = sel __impl_String.append(s, "!") in
  sel __impl_String.len(__t1)
}

=== generic inherent impls dispatch through binder-typed match arms (D-50) ===
:elab(Lumo -> MIR)

data List[A] { .nil, .cons(A, List[A]) }
impl[T] List[T] {
  fn map[R](self: List[T], mapper: (T) -> R): List[R] =
    match self {
      .nil => resume(List.nil),
      .cons(h, t) => resume(List.cons(mapper(h), t.map(mapper)))
    }
}

---

def __impl_List = (bundle { fn map(self, mapper) =>
  case unroll self {
    .nil => ret roll .nil
    .cons(h, t) =>
      let __t1 = force mapper(h) in
      let __t2 = sel __impl_List.map(t, mapper) in
      ret roll .cons(__t1, __t2)
  }
} : List_impl)

=== calls thread capabilities to row'd callees (D-51) ===
:elab(Lumo -> MIR)

cap Console { fn log(msg: String): String }
fn hi(x: String): String / {Console} = Console.log(x)
fn outer(y: String): String / {Console} = hi(y)

---

def hi = (thunk { fn(__cap_Console) => fn(x) => sel __cap_Console.log(x) } : U((Console) -> (String) -> F(String)))
def outer = (thunk { fn(__cap_Console) => fn(y) => force hi(__cap_Console, y) } : U((Console) -> (String) -> F(String)))

=== handle overrides the default impl (D-51) ===
:elab(Lumo -> MIR)

cap Console {
  fn log(m)
}
impl Console {
  fn log(m) = resume(m)
}
fn main() = handle Console with bundle { fn log(m) = resume(m) } in Console.log("x")

---

def __impl_Console = (bundle { fn log(m) => ret m } : Console)
def main = thunk {
  let __t1 = ret (bundle { fn log(m) => ret m } : Console) in
  sel __t1.log("x")
}

=== mutual recursion is a module fixpoint plus projections (D-52) ===
:elab(Lumo -> MIR)

data Nat { .zero, .succ(Nat) }
data Bool { .true, .false }
fn is_even(n: Nat): Bool / {} = match n { .zero => Bool.true, .succ(m) => is_odd(m) }
fn is_odd(n: Nat): Bool / {} = match n { .zero => Bool.false, .succ(m) => is_even(m) }

---

def __grp_is_even_is_odd = (thunk { fix __grp_is_even_is_odd => ret bundle {
  fn is_even(n) =>
    case unroll n {
      .zero => ret roll .true
      .succ(m) => let __t1 = force __grp_is_even_is_odd in sel __t1.is_odd(m)
    }
  fn is_odd(n) =>
    case unroll n {
      .zero => ret roll .false
      .succ(m) => let __t3 = force __grp_is_even_is_odd in sel __t3.is_even(m)
    }
} } : U(F(Grp_is_even_is_odd)))
def is_even = (thunk { fn(n) =>
  let __t2 = force __grp_is_even_is_odd in sel __t2.is_even(n)
} : U((Nat) -> F(Bool)))
def is_odd = (thunk { fn(n) =>
  let __t4 = force __grp_is_even_is_odd in sel __t4.is_odd(n)
} : U((Nat) -> F(Bool)))

=== abortive clauses abort to a try boundary (D-54) ===
:elab(Lumo -> MIR)

cap Console {
  fn log(msg)
}
fn main() = handle Console with bundle { fn log(m) = m } in Console.log("x")

---

def main = thunk {
  try __tok1 in
  let __t2 = ret (bundle { fn log(m) => abort __tok1 m } : Console) in
  sel __t2.log("x")
}

=== mixed tail and abortive clauses share the boundary (D-54) ===
:elab(Lumo -> MIR)

cap E {
  fn op1(x)
  fn op2(x)
}
fn main(a) = handle E with bundle { fn op1(x) = resume(x); fn op2(x) = x } in E.op2(a)

---

def main = thunk { fn(a) =>
  try __tok1 in
  let __t2 = ret (bundle { fn op1(x) => ret x fn op2(x) => abort __tok1 x } : E) in
  sel __t2.op2(a)
}

=== resume strips through if/else and block tails (D-54) ===
:elab(Lumo -> MIR)

data Bool { .true, .false }
cap E {
  fn op(x)
}
fn main(c, a) = handle E with bundle { fn op(x) = {
  let y = x;
  if c { resume(y) } else { resume(a) }
} } in E.op(a)

---

def main = thunk { fn(c) => fn(a) =>
  let __t1 = ret (bundle { fn op(x) =>
    let y = ret x in
    case unroll c {
      .true => ret y
      .false => ret a
    }
  } : E) in
  sel __t1.op(a)
}
